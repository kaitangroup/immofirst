# macOS
.DS_Store

# Composer
/vendor/

# Drupal generated files
/web/sites/default/files/
/web/sites/default/settings.local.php
/web/modules/custom/immo_faq/

# Private files
/private/

# IDE
.idea/
.vscode/

.kilo/index
.kilo/cache
# Production assets are deployed externally.
/production-assets/v1/css/*
/production-assets/v1/js/*
/deploy-production-assets.sh

# Keep the directory structure in Git.
!/production-assets/v1/css/.gitkeep
!/production-assets/v1/js/.gitkeep
