<?php

/**
 * @file
 * Milestone 2: provider offer workflow and the Tab.4 e-mails 4.1–4.4.
 *
 * Search Request lifecycle → e-mail (all sent after the DB commit):
 *   - 4.1 created:    the wizard's SearchRequestNodeCreator saves twice; the
 *                     second save sets field_reference_number. That update
 *                     is the "fully created" moment — see node_update below.
 *   - 4.2 terminated: hook_cron() ends requests whose term has run out.
 *   - 4.3 deleted:    hook_node_delete() for search_request nodes.
 *
 * Provider offer (offer_to_search_request submission):
 *   Pending (on submit) → Approve → Send (forward + 4.4) — OfferWorkflow.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\immofirst_offers\NotificationMailer;
use Drupal\immofirst_offers\OfferUploadGuard;
use Drupal\immofirst_offers\OfferWorkflow;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_entity_base_field_info().
 *
 * Workflow state for provider offers. A base field (schema, installed with
 * the module) rather than a Webform element, so it can't be edited or
 * removed through the Webform UI and isn't shown to providers.
 */
function immofirst_offers_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() !== 'webform_submission') {
    return [];
  }
  $fields['offer_status'] = BaseFieldDefinition::create('list_string')
    ->setLabel(t('Angebotsstatus'))
    ->setDescription(t('Pending → Approved → Sent (only used for offer_to_search_request).'))
    ->setSetting('allowed_values', array_map('strval', OfferWorkflow::statusLabels()));
  return $fields;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for webform_submission.
 */
function immofirst_offers_webform_submission_presave(WebformSubmissionInterface $submission): void {
  if ($submission->isNew() && OfferWorkflow::isOffer($submission) && $submission->get('offer_status')->isEmpty()) {
    $submission->set('offer_status', OfferWorkflow::STATUS_PENDING);
  }
}

/**
 * Implements hook_ENTITY_TYPE_access() for webform_submission.
 *
 * Lets offer managers view offer submissions (and so download their
 * private uploads) without full Webform admin rights. View only.
 */
function immofirst_offers_webform_submission_access(WebformSubmissionInterface $submission, string $operation, AccountInterface $account): AccessResult {
  if ($operation === 'view' && OfferWorkflow::isOffer($submission)) {
    return AccessResult::allowedIfHasPermission($account, 'manage provider offers');
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * Server-side pre-check of the offer upload ("dateien") with German
 * messages, content check and upload flood limit — see OfferUploadGuard.
 */
function immofirst_offers_webform_submission_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $submission = $form_state->getFormObject()->getEntity();
  if ($submission instanceof WebformSubmissionInterface && OfferWorkflow::isOffer($submission) && isset($form['elements']['dateien'])) {
    OfferUploadGuard::protect($form['elements']['dateien']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for node — e-mail 4.1.
 */
function immofirst_offers_node_update(NodeInterface $node): void {
  if ($node->bundle() !== 'search_request') {
    return;
  }
  $original = $node->getOriginal();
  $before = $original ? (string) $original->get('field_reference_number')->value : '';
  $after = (string) $node->get('field_reference_number')->value;
  // The reference number is assigned exactly once, right after the
  // wizard's first save — so this fires once per created search request.
  if ($before === '' && $after !== '') {
    \Drupal::service('immofirst_offers.mailer')->searchRequestCreated($node);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete() for node — e-mail 4.3.
 */
function immofirst_offers_node_delete(NodeInterface $node): void {
  if ($node->bundle() === 'search_request') {
    // Set by the requester's own deletion form (signed e-mail link) only;
    // any other deletion (admin UI, API, Drush) gets the neutral wording.
    $by_requester = \Drupal::request()->attributes->get('immofirst_search_request.deleted_by_requester') === (int) $node->id();
    \Drupal::service('immofirst_offers.mailer')->searchRequestDeleted($node, \Drupal::time()->getRequestTime(), $by_requester);
    \Drupal::keyValue(IMMOFIRST_OFFERS_REMINDER_COLLECTION)->delete($node->id());
  }
}

/**
 * Implements hook_cron() — e-mail 4.2.
 *
 * Ends published search requests whose term has run out — see
 * NotificationMailer::termEnd(): search_request_term_days (requests created
 * since NotificationMailer::termDaysSince()) or, for older requests, the
 * months they were announced with. field_status → closed,
 * unpublished (removed from the public list), then 4.2. Already closed or
 * archived requests are skipped, so each request is ended — and mailed —
 * only once.
 */
function immofirst_offers_cron(): void {
  /** @var \Drupal\immofirst_offers\NotificationMailer $mailer */
  $mailer = \Drupal::service('immofirst_offers.mailer');
  $since = $mailer->termDaysSince();
  $now = (new \DateTimeImmutable('@' . \Drupal::time()->getRequestTime()))->setTimezone(new \DateTimeZone(date_default_timezone_get()));
  // Candidates per rule; the exact end date is checked with termEnd() below.
  $days_cutoff = $now->modify('-' . $mailer->termDays() . ' days')->getTimestamp();
  $months_cutoff = $now->modify('-' . $mailer->legacyTermMonths() . ' months')->getTimestamp();

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'search_request')
    ->condition('status', 1)
    ->sort('created')
    ->range(0, 50);
  $due = $query->orConditionGroup()
    ->condition($query->andConditionGroup()->condition('created', $since, '>=')->condition('created', $days_cutoff, '<='))
    ->condition($query->andConditionGroup()->condition('created', $since, '<')->condition('created', $months_cutoff, '<='));
  $query->condition($due);
  $open = $query->orConditionGroup()
    ->condition('field_status', ['closed', 'archived'], 'NOT IN')
    ->notExists('field_status');
  $ids = $query->condition($open)->execute();

  $logger = \Drupal::logger('immofirst_offers');
  $now = $now->getTimestamp();
  foreach ($storage->loadMultiple($ids) as $node) {
    /** @var \Drupal\node\NodeInterface $node */
    // Same end date as shown in e-mails 4.1/4.2 ("bis …"); month arithmetic
    // around month ends can make the query cutoff a day earlier.
    if ($mailer->termEnd($node) > $now) {
      continue;
    }
    try {
      $node->set('field_status', 'closed');
      $node->setUnpublished();
      $node->save();
      $mailer->searchRequestTerminated($node);
      \Drupal::keyValue(IMMOFIRST_OFFERS_REMINDER_COLLECTION)->delete($node->id());
      $logger->notice('Search request @nid ended after its term.', ['@nid' => $node->id()]);
    }
    catch (\Throwable $e) {
      // One broken request must not stop the rest of the batch; it stays
      // open and is retried on the next cron run.
      $logger->error('Search request @nid could not be ended: @message', ['@nid' => $node->id(), '@message' => $e->getMessage()]);
    }
  }
  // After the expiry pass, so a request that just ended gets no reminder.
  _immofirst_offers_send_expiry_reminders();
}

/**
 * Key-value collection: nid => time the expiry reminder was sent.
 */
const IMMOFIRST_OFFERS_REMINDER_COLLECTION = 'immofirst_offers.expiry_reminder';

/**
 * State key: when the expiry reminder was switched on (per site).
 */
const IMMOFIRST_OFFERS_REMINDER_SINCE_STATE_KEY = 'immofirst_offers.expiry_reminder_since';

/**
 * Sends the "läuft in 7 Tagen ab" reminder, at most once per request.
 *
 * Due when NotificationMailer::reminderTime() (termEnd() − 7 days) has
 * passed and the request is still open: published, not closed/archived,
 * not yet expired. Each request is claimed atomically before sending
 * (setIfNotExists), so repeated or overlapping cron runs can't send twice;
 * the claim is only released if the mail system rejects the message, so the
 * next run retries. Requests whose reminder moment lies before the feature
 * was switched on, or before the request even existed (term of 7 days or
 * less), get no reminder — they simply expire with e-mail 4.2.
 *
 * After claiming, the node is reloaded from the database (bypassing the
 * entity cache) and checked again, so a request deleted, unpublished or
 * closed since the query gets no reminder, and the mail uses its current
 * e-mail address, Such-ID and end date.
 */
function _immofirst_offers_send_expiry_reminders(): void {
  /** @var \Drupal\immofirst_offers\NotificationMailer $mailer */
  $mailer = \Drupal::service('immofirst_offers.mailer');
  $sent = \Drupal::keyValue(IMMOFIRST_OFFERS_REMINDER_COLLECTION);
  $logger = \Drupal::logger('immofirst_offers');
  $tz = new \DateTimeZone(date_default_timezone_get());
  $now = \Drupal::time()->getRequestTime();
  $active_since = (int) \Drupal::state()->get(IMMOFIRST_OFFERS_REMINDER_SINCE_STATE_KEY, 0);
  $days_since = $mailer->termDaysSince();
  $lead = '+' . NotificationMailer::REMINDER_DAYS . ' days';

  // created ↔ reminder moment, per term rule (exactly checked again below).
  $window = function (string $term) use ($tz, $now, $active_since, $lead): array {
    $at = fn (int $ts) => (new \DateTimeImmutable('@' . $ts))->setTimezone($tz)->modify($lead)->modify('-' . $term)->getTimestamp();
    return [$at($active_since), $at($now)];
  };
  [$days_from, $days_to] = $window($mailer->termDays() . ' days');
  [$months_from, $months_to] = $window($mailer->legacyTermMonths() . ' months');

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'search_request')
    ->condition('status', 1)
    ->sort('created')
    ->range(0, 50);
  $due = $query->orConditionGroup()
    ->condition($query->andConditionGroup()->condition('created', $days_since, '>=')->condition('created', [$days_from, $days_to], 'BETWEEN'))
    ->condition($query->andConditionGroup()->condition('created', $days_since, '<')->condition('created', [$months_from, $months_to], 'BETWEEN'));
  $query->condition($due);
  $query->condition($query->orConditionGroup()
    ->condition('field_status', ['closed', 'archived'], 'NOT IN')
    ->notExists('field_status'));
  if ($already = array_keys($sent->getAll())) {
    // Drop tracking records of requests that no longer exist (e.g. deleted
    // without hook_node_delete() running), so the list doesn't grow forever.
    $existing = $storage->getQuery()->accessCheck(FALSE)->condition('nid', $already, 'IN')->execute();
    if ($stale = array_diff($already, array_map('intval', $existing))) {
      $sent->deleteMultiple($stale);
    }
    $query->condition('nid', $already, 'NOT IN');
  }

  $due = static fn (NodeInterface $node): bool => _immofirst_offers_expiry_reminder_due($node, $mailer, $now, $active_since);
  foreach ($query->execute() as $nid) {
    $node = $storage->load($nid);
    if (!$node instanceof NodeInterface || !$due($node)) {
      continue;
    }
    if (!$sent->setIfNotExists($nid, $now)) {
      continue;
    }
    // Recheck the current state right before sending: the request may have
    // been deleted or changed since the query (or by an overlapping run).
    $storage->resetCache([$nid]);
    $node = $storage->load($nid);
    if (!$node instanceof NodeInterface || !$due($node)) {
      $logger->notice('Expiry reminder for search request @nid skipped: deleted or no longer eligible.', ['@nid' => $nid]);
      $sent->delete($nid);
      continue;
    }
    try {
      if ($mailer->searchRequestExpiring($node)) {
        $logger->notice('Expiry reminder sent for search request @nid (ends @end).', ['@nid' => $node->id(), '@end' => date('c', $mailer->termEnd($node))]);
        continue;
      }
      $logger->warning('Expiry reminder for search request @nid was not accepted by the mail system; will retry on the next cron run.', ['@nid' => $node->id()]);
    }
    catch (\Throwable $e) {
      $logger->error('Expiry reminder for search request @nid failed: @message', ['@nid' => $node->id(), '@message' => $e->getMessage()]);
    }
    $sent->delete($node->id());
  }
}

/**
 * Whether $node should get the expiry reminder now.
 *
 * Search request, published, not closed/archived, reminder moment reached
 * but not before the feature was switched on or the request was created,
 * and not yet expired.
 */
function _immofirst_offers_expiry_reminder_due(NodeInterface $node, NotificationMailer $mailer, int $now, int $active_since): bool {
  if ($node->bundle() !== 'search_request' || !$node->isPublished()) {
    return FALSE;
  }
  if (in_array((string) $node->get('field_status')->value, ['closed', 'archived'], TRUE)) {
    return FALSE;
  }
  $remind_at = $mailer->reminderTime($node);
  return $remind_at <= $now && $remind_at >= $active_since && $remind_at > (int) $node->getCreatedTime() && $mailer->termEnd($node) > $now;
}

/**
 * Implements hook_mail().
 */
function immofirst_offers_mail(string $key, array &$message, array $params): void {
  \Drupal::service('immofirst_offers.mailer')->buildMessage($key, $message, $params);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function immofirst_offers_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  // Runs after UserLoginForm::submitForm(), so it only replaces the default
  // "go to your user page" redirect. An explicit ?destination still wins.
  $form['#submit'][] = 'immofirst_offers_plaing_admin_login_redirect';
}

/**
 * Login submit handler: sends Plaing Admins to the offers list.
 *
 * Only for accounts that have the plaing_admin role, no administrator-type
 * role (is_admin) and are not user 1 — those keep Drupal's normal login
 * behaviour — and only if the account can actually open the offers list.
 */
function immofirst_offers_plaing_admin_login_redirect(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::entityTypeManager()->getStorage('user')->load($form_state->get('uid'));
  if (!$account instanceof UserInterface
    || (int) $account->id() === 1
    || !in_array('plaing_admin', $account->getRoles(), TRUE)) {
    return;
  }
  /** @var \Drupal\user\RoleInterface[] $roles */
  $roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple($account->getRoles());
  foreach ($roles as $role) {
    if ($role->isAdmin()) {
      return;
    }
  }
  $url = Url::fromRoute('immofirst_offers.list');
  if ($url->access($account)) {
    $form_state->setRedirectUrl($url);
  }
}

/**
 * Implements hook_theme().
 */
function immofirst_offers_theme(): array {
  return [
    'immofirst_offers_email' => [
      'variables' => [
        'email_key' => '',
        'texts' => [],
        'rows' => [],
        'button_url' => '',
        'seller' => NULL,
        'preview' => NULL,
        'delete_url' => '',
        'site' => [],
      ],
    ],
  ];
}
