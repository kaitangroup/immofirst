{#
/**
 * @file
 * Shared layout for the Tab.4 e-mails (4.1–4.4) and the offer forward.
 *
 * Table layout + inline styles for e-mail clients. Texts come from
 * immofirst_offers.settings (editable at /admin/config/system/immofirst-emails);
 * multi-line texts are split into paragraphs on line breaks.
 *
 * Variables:
 * - email_key: search_request_created | search_request_terminated |
 *   search_request_deleted | offer_sent | offer_forward.
 * - texts: that e-mail's config texts.
 * - rows: summary rows [{label, value, note}].
 * - button_url: absolute URL for the main button.
 * - offer: rendered offer values (offer_forward only).
 * - site: brand/footer values.
 */
#}
{% set navy = '#142A5C' %}
{% set blue = '#2563FF' %}
{% set muted = '#5B6B8C' %}
{% set font = "font-family:Arial,Helvetica,sans-serif;" %}
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ texts.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#F3F6FC;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F3F6FC;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#FFFFFF;border-radius:16px;{{ font }}color:{{ navy }};">

        {# Header #}
        <tr>
          <td style="padding:24px 32px;border-bottom:1px solid #E6ECF7;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="{{ font }}font-size:22px;font-weight:bold;"><a href="{{ site.home_url }}" style="color:{{ navy }};text-decoration:none;">{{ site.brand_name }}</a></td>
                <td align="right" style="{{ font }}font-size:13px;color:{{ muted }};">{{ site.tagline }}</td>
              </tr>
            </table>
          </td>
        </tr>

        {# Hero #}
        <tr>
          <td style="padding:32px 32px 8px;background:#F5F8FF;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td width="56" valign="top" style="padding-right:16px;">
                  <div style="width:48px;height:48px;line-height:48px;border-radius:24px;background:#DCE6FF;color:{{ blue }};font-size:24px;font-weight:bold;text-align:center;">{{ email_key == 'search_request_terminated' ? '&#9201;'|raw : '&#10003;'|raw }}</div>
                </td>
                <td valign="top" style="{{ font }}">
                  <h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;color:{{ navy }};">{{ texts.heading }}</h1>
                  {% for line in texts.intro|split("\n")|filter(l => l|trim) %}
                    <p style="margin:0 0 10px;font-size:15px;line-height:1.5;color:{{ navy }};">{{ line }}</p>
                  {% endfor %}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {# Summary #}
        {% if rows %}
        <tr>
          <td style="padding:24px 32px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6ECF7;border-radius:12px;">
              <tr><td colspan="2" style="padding:18px 20px 6px;{{ font }}font-size:17px;font-weight:bold;">{{ texts.summary_heading }}</td></tr>
              {% for row in rows %}
                <tr>
                  <td width="38%" valign="top" style="padding:12px 20px;border-top:1px solid #EEF2F9;{{ font }}font-size:14px;color:{{ muted }};">{{ row.label }}</td>
                  {# Values (incl. Such-ID) in black/navy, not blue — Tab.4 note. #}
                  <td valign="top" style="padding:12px 20px;border-top:1px solid #EEF2F9;{{ font }}font-size:14px;color:{{ navy }};">
                    {{ row.value }}
                    {% if row.note %}<br><span style="color:{{ muted }};">{{ row.note }}</span>{% endif %}
                  </td>
                </tr>
              {% endfor %}
            </table>
          </td>
        </tr>
        {% endif %}

        {# Forwarded offer (offer_forward only): rendered by Webform from its configured elements. #}
        {% if offer %}
        <tr>
          <td style="padding:16px 32px 8px;{{ font }}">
            <h2 style="margin:0 0 10px;font-size:17px;color:{{ navy }};">{{ texts.next_heading }}</h2>
            <div style="font-size:14px;line-height:1.5;color:{{ navy }};">{{ offer }}</div>
          </td>
        </tr>
        {% endif %}

        {# Next steps + button #}
        {% if not offer and (texts.next_heading or texts.next_text) %}
        <tr>
          <td style="padding:16px 32px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F8FF;border-radius:12px;">
              <tr>
                <td style="padding:20px;{{ font }}">
                  {% if texts.next_heading %}<p style="margin:0 0 8px;font-size:16px;font-weight:bold;color:{{ navy }};">{{ texts.next_heading }}</p>{% endif %}
                  {% for line in texts.next_text|split("\n")|filter(l => l|trim) %}
                    <p style="margin:0 0 6px;font-size:14px;line-height:1.5;color:{{ navy }};">{% if email_key == 'search_request_created' %}<span style="color:{{ blue }};font-weight:bold;">&#10003;</span>&nbsp; {% endif %}{{ line }}</p>
                  {% endfor %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {% if texts.button_label and button_url %}
        <tr>
          <td align="center" style="padding:20px 32px 8px;{{ font }}">
            {% if texts.button_caption and email_key == 'offer_sent' %}<p style="margin:0 0 12px;font-size:15px;color:{{ navy }};">{{ texts.button_caption }}</p>{% endif %}
            <a href="{{ button_url }}" style="display:inline-block;padding:14px 28px;background:{{ blue }};color:#FFFFFF;font-size:15px;font-weight:bold;text-decoration:none;border-radius:8px;">{{ texts.button_label }} &rarr;</a>
            {% if texts.button_caption and email_key != 'offer_sent' %}<p style="margin:10px 0 0;font-size:13px;color:{{ muted }};">{{ texts.button_caption }}</p>{% endif %}
          </td>
        </tr>
        {% endif %}

        {% if texts.extra_heading or texts.extra_text %}
        <tr>
          <td style="padding:16px 32px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F8FF;border-radius:12px;">
              <tr>
                <td style="padding:20px;{{ font }}">
                  {% if texts.extra_heading %}<p style="margin:0 0 6px;font-size:15px;font-weight:bold;color:{{ navy }};">&#9825; {{ texts.extra_heading }}</p>{% endif %}
                  {% for line in texts.extra_text|split("\n")|filter(l => l|trim) %}
                    <p style="margin:0;font-size:14px;line-height:1.5;color:{{ navy }};">{{ line }}</p>
                  {% endfor %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {# Footer #}
        <tr>
          <td style="padding:24px 32px;border-top:1px solid #E6ECF7;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td valign="top" style="{{ font }}">
                  <div style="font-size:18px;font-weight:bold;color:{{ navy }};">{{ site.brand_name }}</div>
                  <div style="font-size:13px;color:{{ muted }};">{{ site.tagline }}</div>
                </td>
                {% if site.contact_url %}
                <td align="right" valign="top" style="{{ font }}font-size:13px;color:{{ muted }};">
                  <strong style="color:{{ navy }};">{{ 'Haben Sie Fragen?'|t }}</strong><br>
                  {{ 'Wir sind gerne für Sie da.'|t }}<br>
                  <a href="{{ site.contact_url }}" style="color:{{ blue }};">{{ 'Kontakt aufnehmen'|t }}</a>
                </td>
                {% endif %}
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;">
        <tr>
          <td align="center" style="padding:16px 12px;{{ font }}font-size:12px;line-height:1.6;color:{{ muted }};">
            {{ site.footer_note }}<br>
            {{ site.footer_company }}
            {% if site.imprint_url %} &middot; <a href="{{ site.imprint_url }}" style="color:{{ muted }};">{{ 'Impressum'|t }}</a>{% endif %}
            {% if site.privacy_url %} &middot; <a href="{{ site.privacy_url }}" style="color:{{ muted }};">{{ 'Datenschutz'|t }}</a>{% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
