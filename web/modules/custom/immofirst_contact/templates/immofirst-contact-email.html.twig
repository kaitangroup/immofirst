{#
/**
 * @file
 * Contact inquiry notification (to info@immo-gesuch.de).
 *
 * All values are visitor input and are escaped by Twig autoescape.
 */
#}
{% set font = 'font-family:Inter,Arial,Helvetica,sans-serif;' %}
<div style="{{ font }}font-size:15px;line-height:1.55;color:#111827;">
  <p style="margin:0 0 16px;">{{ 'Neue Kontaktanfrage über das Kontaktformular auf Immo-Gesuch.de:'|t }}</p>
  <table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 16px;">
    <tr><td style="padding:4px 16px 4px 0;color:#667085;">{{ 'Name'|t }}</td><td style="padding:4px 0;">{{ name }}</td></tr>
    <tr><td style="padding:4px 16px 4px 0;color:#667085;">{{ 'E-Mail'|t }}</td><td style="padding:4px 0;">{{ email }}</td></tr>
    <tr><td style="padding:4px 16px 4px 0;color:#667085;">{{ 'Betreff'|t }}</td><td style="padding:4px 0;">{{ subject }}</td></tr>
  </table>
  <p style="margin:0 0 4px;color:#667085;">{{ 'Nachricht'|t }}</p>
  <div style="margin:0 0 16px;padding:12px 16px;background:#F5F7FD;border-radius:8px;white-space:pre-wrap;">{{ message }}</div>
  <p style="margin:0;color:#667085;font-size:13px;">{{ 'Antworten Sie direkt auf diese E-Mail, um dem Absender zu antworten.'|t }}</p>
</div>
