<?php

/**
 * @file
 * Hook implementations for the ImmoFirst Search Request wizard.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function immofirst_search_request_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'search_request_wizard' => [
      'render element' => 'form',
      'template' => 'search-request-wizard',
      'path' => $path . '/templates',
    ],
    'search_request_thank_you' => [
      'variables' => [
        'reference_number' => NULL,
        'node' => NULL,
      ],
      'template' => 'search-request-thank-you',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_node_view().
 *
 * Adds a computed "Pachtpreis" row to the search_request detail page
 * (node canonical view), Mieten + Grundstück only — field_lease_price_
 * min/max is only ever populated for that one combination (see
 * SearchRequestWizardForm::step2FieldsForSelection()), so this is a
 * no-op for every other request_type/property_type pairing without
 * needing to check them explicitly. Hidden entirely when both min and
 * max are empty, per spec.
 *
 * Deliberately implemented here rather than in the theme: this only
 * adds a new render array key to the node's existing $build (standard
 * Drupal API, no theme template or CSS involved), so it can't affect
 * Kaufen/Wohnung/Haus/Garage/Gewerbe's existing markup or styling.
 */
function immofirst_search_request_node_view(array &$build, \Drupal\node\NodeInterface $node, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, string $view_mode): void {
  if ($node->bundle() !== 'search_request') {
    return;
  }

  if (!$node->hasField('field_request_type') || !$node->hasField('field_property_type')
    || !$node->hasField('field_lease_price_min') || !$node->hasField('field_lease_price_max')) {
    // Fields not yet present on this site (e.g. config not imported
    // yet) — nothing to show, and nothing to error on.
    return;
  }

  if ((string) $node->get('field_request_type')->value !== 'mieten'
    || (string) $node->get('field_property_type')->value !== 'land') {
    return;
  }

  $min = $node->get('field_lease_price_min')->value;
  $max = $node->get('field_lease_price_max')->value;
  $minEmpty = $min === NULL || $min === '';
  $maxEmpty = $max === NULL || $max === '';

  if ($minEmpty && $maxEmpty) {
    return;
  }

  $build['field_lease_price_display'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['search-request-pachtpreis']],
    '#weight' => 40,
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#value' => t('Pachtpreis'),
      '#attributes' => ['class' => ['search-request-pachtpreis__label']],
    ],
    'value' => [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#value' => _immofirst_search_request_format_lease_price_range(
        $minEmpty ? NULL : (string) $min,
        $maxEmpty ? NULL : (string) $max,
      ),
      '#attributes' => ['class' => ['search-request-pachtpreis__value']],
    ],
  ];
}

/**
 * Formats a Pachtpreis min/max pair as "500 € – 900 €".
 *
 * Open-ended ranges (only one side set) render as "ab 500 €" / "bis
 * 900 €" instead of a dangling "500 € –"; the both-empty case never
 * reaches here (see the caller's early return).
 */
function _immofirst_search_request_format_lease_price_range(?string $min, ?string $max): string {
  $format = static fn (string $value): string => number_format((float) $value, 0, ',', '.') . ' €';

  if ($min === NULL) {
    return t('bis @max', ['@max' => $format($max)])->render();
  }

  if ($max === NULL) {
    return t('ab @min', ['@min' => $format($min)])->render();
  }

  return $format($min) . ' – ' . $format($max);
}

/**
 * Implements hook_preprocess_HOOK() for search-request-wizard.html.twig.
 *
 * IMPORTANT: because this template overrides the 'form' render element's
 * theme hook, Drupal's default form.html.twig (which normally emits the
 * <form> tag itself, with action/method/attributes) is bypassed. This
 * preprocess function is responsible for reconstructing that same
 * "form_attributes" variable so the template can build a real, working
 * <form> element instead of an inert <div>.
 */
function template_preprocess_search_request_wizard(array &$variables): void {
  $form = $variables['form'];

  $variables['current_step'] = $form['#immofirst_step'] ?? 1;
  $variables['total_steps'] = $form['#immofirst_total_steps'] ?? 5;
  $variables['step_titles'] = $form['#immofirst_step_titles'] ?? [];
  $variables['progress_percent'] = $variables['total_steps']
    ? (int) round(($variables['current_step'] / $variables['total_steps']) * 100)
    : 0;

  $attributes = $form['#attributes'] ?? [];
  $attributes['action'] = $form['#action'] ?? '';
  $attributes['method'] = $form['#method'] ?? 'post';
  if (!empty($form['#id'])) {
    $attributes['id'] = $attributes['id'] ?? $form['#id'];
  }
  $variables['form_attributes'] = new \Drupal\Core\Template\Attribute($attributes);

  // Render the rest of the form (everything except the properties we
  // just consumed above) as-is; Drupal's own element children carry the
  // actual step markup built in the form class.
  $variables['form'] = $form;
}

/**
 * Implements hook_views_pre_view().
 *
 * Feeds the homepage's custom search form (a plain <form method="get">
 * in the theme, not Views' own auto-rendered exposed form — submitting
 * it just navigates to ?art=..&immobilienart=..&ort=..) into the
 * search_requests View's exposed input.
 *
 * This exact logic previously lived in suchauftrag_theme.theme, as
 * suchauftrag_theme_views_pre_view(). It never ran: hook_views_pre_view()
 * is a general-purpose hook, and Drupal's ModuleHandler::invokeAll()
 * only scans enabled MODULES for hook implementations — via
 * getImplementationInfo(), which iterates $this->moduleList only — never
 * theme .theme files (those are limited to hook_preprocess_*(),
 * hook_theme(), and theme-suggestion hooks). So the exposed input was
 * always empty and every request returned the same unfiltered result
 * set regardless of the URL, no matter how the .theme file's version of
 * this function was written.
 *
 * This module IS scanned for hook_views_pre_view(), so implementing it
 * here actually fires — and it fires for every execution of this view,
 * however it's triggered (views_embed_view(), the Block Layout system,
 * a Views UI preview, etc.), which is more robust than any single call
 * site setting exposed input manually.
 *
 * Only genuinely-provided, non-empty query parameters are applied — an
 * absent or empty value must mean "no filter on this field", never
 * "filter for an empty value" (which would hide every result, since no
 * node stores e.g. field_request_type_value as an empty string).
 *
 * Starts from the view's own getExposedInput() (which itself already
 * falls back to the current request's query string) rather than a
 * blank array, so this only ever adds/overrides these three specific
 * identifiers instead of discarding any exposed input Views may already
 * have assembled through some other path.
 *
 * ---------------------------------------------------------------------
 * TEMPORARY DEBUG INSTRUMENTATION (see channel 'immofirst_search_request',
 * severity DEBUG) — added to determine exactly why filtering still isn't
 * taking effect, per the outstanding "Views filtering not working"
 * investigation. Every stage of this function now logs its state. Two
 * log entries are emitted UNCONDITIONALLY, for every view this fires
 * for (not just 'search_requests'), specifically so the logs can prove
 * or disprove "the hook never runs at all" independently of whether
 * it's the right view. No behavior below has changed — only logging
 * was added. Remove the \Drupal::logger() calls (and this block) once
 * the root cause is confirmed and fixed.
 * ---------------------------------------------------------------------
 */
