{#
/**
 * @file
 * Search request wizard — confirmation ("Suchauftrag erstellt!") page.
 *
 * Variables:
 *   reference_number   string|null, e.g. "SA-2026-000123"
 *   node                the created node entity, or null
 */
#}
<div class="wizard-page">
  <header class="wizard-page__header">
    <a href="/" class="wizard-page__logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 10.5L12 3l9 7.5" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M5 9.5V19a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V9.5" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Suchauftrag.de
    </a>
    <span class="wizard-page__badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.2l6.5 2.6v5.7c0 4.3-2.8 7.2-6.5 8.5-3.7-1.3-6.5-4.2-6.5-8.5V5.8L12 3.2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      100% kostenlos
    </span>
  </header>

  <div class="wizard-progress">
    <p class="wizard-progress__label">Schritt 5 von 5</p>
    <div class="wizard-progress__track">
      <div class="wizard-progress__fill" style="width: 100%"></div>
    </div>
  </div>

  <div class="wizard wizard--success">
    <div class="wizard__inner">
      <div class="wizard-success">
        <span class="wizard-success__icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#22C55E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>

        <h1 class="wizard-success__title">Suchauftrag erstellt!</h1>
        <p class="wizard-success__text">Vielen Dank! Ihr Suchauftrag wurde erfolgreich gespeichert.</p>

        <ul class="wizard-success__list">
          <li>
            <span class="wizard-success__list-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5.5" width="17" height="13" rx="1.8" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 7l7.5 5.5L19.5 7" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Sie erhalten passende Angebote per E-Mail.
          </li>
          <li>
            <span class="wizard-success__list-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 20l1.2-3.6a8 8 0 113.1 3L4 20z" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Sie können Ihren Suchauftrag jederzeit bearbeiten oder löschen.
          </li>
          <li>
            <span class="wizard-success__list-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="4.8" y="10.5" width="14.4" height="9.5" rx="2.2" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.8 10.5V7.8a4.2 4.2 0 018.4 0v2.7" stroke="#134beb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Ihre Daten bleiben vertraulich und werden nicht weitergegeben.
          </li>
        </ul>

        {% if reference_number %}
          <div class="wizard-success__reference">
            <span class="wizard-success__reference-label">Ihre Suchauftragsnummer</span>
            <span class="wizard-success__reference-number">{{ reference_number }}</span>
          </div>
        {% endif %}

        <a href="/" class="btn btn--outline wizard-success__home-link">Zur Startseite</a>
      </div>
    </div>
  </div>
</div>
