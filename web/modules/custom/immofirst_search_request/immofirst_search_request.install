      'name' => 'request_type',
      'type' => 'list_string',
      'label' => 'Anfrageart',
      'storage' => [
        'allowed_values' => [
          'kaufen' => 'Kaufen',
          'mieten' => 'Mieten',
        ],
      ],
    ],
    [
      'name' => 'property_type',
      'type' => 'list_string',
      'label' => 'Objektart',
      'storage' => [
        'allowed_values' => [
          'apartment' => 'Wohnung',
          'house' => 'Haus',
          'land' => 'Grundstück',
          'garage' => 'Stellplatz / Garage',
          'commercial' => 'Gewerbe',
        ],
      ],
    ],
    [
      'name' => 'location',
      'type' => 'string',
      'label' => 'Ort oder PLZ',
      'storage' => ['max_length' => 255],
    ],
    [
      'name' => 'radius',
      'type' => 'list_integer',
      'label' => 'Umkreis (km)',
      'storage' => [
        'allowed_values' => [
          5 => '5 km',
          10 => '10 km',
          15 => '15 km',
          25 => '25 km',
          50 => '50 km',
          100 => '100 km',
        ],
