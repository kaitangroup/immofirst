    ],

    // ---- Step 2: Anforderungen (conditional on Step 1) --------------
    [
      'name' => 'area_min',
      'type' => 'integer',
      'label' => 'Wohnfläche min. (m²)',
      'storage' => ['unsigned' => TRUE],
