/**
 * Creates the "search_request" content type and all of its fields.
 *
 * Idempotent: every step (node type, each field storage, each field
 * instance) is guarded by an existence check, so this can safely be
 * called from both hook_install() (fresh installs) and an update hook
 * (already-installed sites) without erroring or duplicating config.
 *
 * Does NOT touch "suchauftrag" in any way, and does NOT change what
 * content type the wizard writes to (see SearchRequestNodeCreator) —
 * that remains a later phase.
 */
function _immofirst_search_request_install_search_request_type(): void {
  if (!NodeType::load('search_request')) {
    NodeType::create([
      'type' => 'search_request',
      'name' => 'Search Request',
      'description' => 'Buyer/tenant search requests submitted through the "Suchauftrag erstellen" wizard. Not to be confused with "suchauftrag", which holds provider property LISTINGS.',
      'new_revision' => TRUE,
      'display_submitted' => FALSE,
    ])->save();
  }

  foreach (_immofirst_search_request_field_definitions() as $definition) {
    $fieldName = 'field_' . $definition['name'];

    _immofirst_search_request_ensure_field_storage(
      $fieldName,
      $definition['type'],
      $definition['storage'] ?? [],
      $definition['cardinality'] ?? 1,
    );

    _immofirst_search_request_ensure_field_instance(
      $fieldName,
      'search_request',
      $definition['label'],
      $definition['description'] ?? NULL,
    );
  }
}

/**
 * Creates a node FieldStorageConfig if one doesn't already exist.
 *
 * If a same-named storage already exists (e.g. shared with
 * "suchauftrag", such as field_location) it's left untouched and
 * reused as-is, PROVIDED its type matches what we need — a type
 * mismatch is left alone and logged via an exception rather than
 * silently attaching an incompatible field, since that would corrupt
 * data on whichever bundle is wrong.
 *
 * @param string $fieldName
 *   Field machine name, including the "field_" prefix.
 * @param string $type
 *   Field type plugin ID (e.g. 'string', 'list_string', 'decimal').
 * @param array<string, mixed> $settings
 *   Field storage settings (e.g. 'allowed_values', 'max_length').
 * @param int $cardinality
 *   Field cardinality; -1 for unlimited.
 */
function _immofirst_search_request_ensure_field_storage(string $fieldName, string $type, array $settings, int $cardinality): void {
  $existing = FieldStorageConfig::loadByName('node', $fieldName);

  if ($existing) {
    if ($existing->getType() !== $type) {
      throw new \RuntimeException(sprintf(
        'Field storage "%s" already exists on node as type "%s", but search_request needs type "%s". Rename the search_request field or reconcile the type before continuing.',
        $fieldName,
        $existing->getType(),
        $type,
      ));
    }

    return;
  }

  FieldStorageConfig::create([
    'field_name' => $fieldName,
    'entity_type' => 'node',
    'type' => $type,
    'cardinality' => $cardinality,
    'settings' => $settings,
    'translatable' => FALSE,
  ])->save();
}

/**
 * Creates a node FieldConfig (field instance on a bundle) if one
 * doesn't already exist.
 *
 * @param string $fieldName
 *   Field machine name, including the "field_" prefix.
 * @param string $bundle
 *   Content type machine name.
 * @param string $label
 *   Admin-facing field label for this bundle.
 * @param string|null $description
 *   Admin help text, if any.
 */
function _immofirst_search_request_ensure_field_instance(string $fieldName, string $bundle, string $label, ?string $description): void {
  if (FieldConfig::loadByName('node', $bundle, $fieldName)) {
    return;
  }

  FieldConfig::create([
    'field_name' => $fieldName,
    'entity_type' => 'node',
    'bundle' => $bundle,
    'label' => $label,
    'description' => $description ?? '',
    'required' => FALSE,
  ])->save();
}


/**
 * Creates the "search_criteria" taxonomy vocabulary and its term
 * fields (Group + the internal Objektart-applicability field), if
 * they don't already exist.
 *
 * Idempotent, like _immofirst_search_request_install_search_request_type()
 * — every piece is existence-checked, so this is safe to call from
 * both hook_install() and an update hook.
 */
function _immofirst_search_request_install_search_criteria_vocabulary(): void {
  if (!Vocabulary::load('search_criteria')) {
    Vocabulary::create([
      'vid' => 'search_criteria',
      'name' => 'Search Criteria',
      'description' => 'One term per Step 3 "Zusätzliche Kriterien" checkbox (Tab.2.1 of ImmoFirst_260826.xlsx). Populated by _immofirst_search_request_install_search_criteria_terms() from _immofirst_search_request_criteria_term_definitions() — do not hand-edit labels or add/remove terms here; fix at that source instead.',
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('taxonomy_term', 'field_group')) {
    FieldStorageConfig::create([
      'field_name' => 'field_group',
      'entity_type' => 'taxonomy_term',
      'type' => 'string',
      'settings' => ['max_length' => 255],
      'translatable' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('taxonomy_term', 'search_criteria', 'field_group')) {
    FieldConfig::create([
      'field_name' => 'field_group',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'search_criteria',
      'label' => 'Group',
      'description' => 'The Tab.2.1 section heading this criterion belongs under (e.g. "Ausstattung", "Bonität & zusätzliche Angaben"). Drives Step 3\'s checkbox card groupings (SearchCriteriaTermRepository) and, later, the detail page\'s "Zusätzliche Kriterien" headings — neither hardcodes group names, both derive them from this field.',
      'required' => TRUE,
    ])->save();
  }

  // Not part of the client's 2-field spec (Label/Group) — added
  // because several Tab.2.1 groups reuse the exact same heading text
  // for different property types with DIFFERENT option sets (e.g.
  // "Nutzung" under Haus vs. "Nutzung" under Garage/Stellplatz), and
  // some groups' option sets partially overlap ACROSS property types
  // under the one shared heading (e.g. "Ausstattung" for Wohnung vs.
  // Haus). Without recording which Objektart(en) a term applies to,
  // Step 3 could no longer tell those apart — it would either merge
  // unrelated options into one card, or show options for the wrong
  // Objektart. Purely internal/structural (never its own heading or
  // field shown to the customer); still one single vocabulary, exactly
  // as specified.
  if (!FieldStorageConfig::loadByName('taxonomy_term', 'field_property_types')) {
    FieldStorageConfig::create([
      'field_name' => 'field_property_types',
      'entity_type' => 'taxonomy_term',
      'type' => 'list_string',
      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
      'settings' => [
        'allowed_values' => [
          'apartment' => 'Wohnung',
          'house' => 'Haus',
          'land' => 'Grundstück',
          'garage' => 'Garage / Stellplatz',
          'commercial' => 'Gewerbe',
        ],
      ],
      'translatable' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('taxonomy_term', 'search_criteria', 'field_property_types')) {
    FieldConfig::create([
      'field_name' => 'field_property_types',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'search_criteria',
      'label' => 'Gilt für Objektart(en)',
      'description' => 'Internal only — which Step 2 Objektart(en) show this checkbox in Step 3. Never displayed to the customer.',
      'required' => TRUE,
    ])->save();
  }
}

/**
 * search_criteria taxonomy term definitions, transcribed verbatim
 * from Tab.2.1 of ImmoFirst_260826.xlsx — the same source data and
 * same two documented exceptions (Grundstück's "Erschlossen" heading,
 * and "Beim Kauf" being an internal condition rather than a checkbox
 * or heading) that previously lived in
 * SearchRequestWizardForm::CRITERIA_GROUPS. Deduplicated across
 * property types: a label that's identical AND under the same Group
 * heading for more than one Objektart (e.g. every "Bonität &
 * zusätzliche Angaben" option, shared by all five property types)
 * becomes ONE term with multiple 'property_types' entries, rather
 * than one duplicate term per property type — see
 * SearchCriteriaTermRepository, which filters by 'property_types'.
 *
 * 'weight' preserves the workbook's own top-to-bottom option order
 * (taxonomy_term's native "weight" field — no separate field needed);
 * gaps of 10 between values just leave room to insert a term later
 * without renumbering everything else.
 *
 * "Beim Kauf" itself is intentionally absent below — per the
 * workbook's note it's an internal sub-category condition, not a
 * checkbox and not a heading, so no term or Group value is ever
 * created for it. Its three real options ("Finanzierung gesichert",
 * "Eigenkapital vorhanden", "Kauf ohne Finanzierung möglich") ARE
 * created as normal terms in "Bonität & zusätzliche Angaben" —
 * SearchRequestWizardForm::filterCriteriaOptionsForRequestType()
 * still only shows them for Kaufen, exactly as before.
 *
 * @return array<int, array{label: string, group: string, weight: int, property_types: string[]}>
 */
function _immofirst_search_request_criteria_term_definitions(): array {
  return [
    // ---- Ausstattung ----
    ['label' => 'Balkon', 'group' => 'Ausstattung', 'weight' => 0, 'property_types' => ['apartment']],
    ['label' => 'Terrasse', 'group' => 'Ausstattung', 'weight' => 10, 'property_types' => ['apartment']],
    ['label' => 'Garten / Gartennutzung', 'group' => 'Ausstattung', 'weight' => 20, 'property_types' => ['apartment']],
    ['label' => 'Aufzug', 'group' => 'Ausstattung', 'weight' => 30, 'property_types' => ['apartment']],
    ['label' => 'Keller', 'group' => 'Ausstattung', 'weight' => 40, 'property_types' => ['apartment']],
    ['label' => 'Abstellraum', 'group' => 'Ausstattung', 'weight' => 50, 'property_types' => ['apartment']],
    ['label' => 'Gäste-WC', 'group' => 'Ausstattung', 'weight' => 60, 'property_types' => ['apartment', 'house']],
    ['label' => 'Einbauküche', 'group' => 'Ausstattung', 'weight' => 70, 'property_types' => ['apartment', 'house']],
