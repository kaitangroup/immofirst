<?php

declare(strict_types=1);

/**
 * @file
 * Install/uninstall hooks for the ImmoFirst Search Request module.
 *
 * ARCHITECTURE NOTE (Phase 1 of the suchauftrag/search_request split):
 * Buyer/tenant search requests created by the wizard were originally
 * stored as "suchauftrag" nodes (a content type meant for provider
 * property LISTINGS), with all wizard answers besides a handful of
 * legacy fields flattened into one field_search_criteria JSON blob.
 * That is being corrected: a dedicated "search_request" content type
 * with one real Drupal field per wizard answer is introduced below.
 *
 * Phase 1 scope is structural only:
 * - immofirst_search_request_install() (suchauftrag / legacy JSON
 *   field) is UNCHANGED — nothing is removed from or added to
 *   suchauftrag, and no suchauftrag data is touched.
 * - _immofirst_search_request_install_search_request_type() ADDS the
 *   new search_request content type and its fields, wired up for
 *   fresh installs (hook_install) and already-installed sites
 *   (hook_update_11001) alike.
 * - The wizard form, its AJAX flow, and SearchRequestNodeCreator still
 *   read/write "suchauftrag" exactly as before. Pointing node creation
 *   at "search_request" is a later phase, not part of this change.
 */

use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 *
 * Only provisions the legacy JSON field used by the original
 * "suchauftrag" wizard. All structural configuration for the
 * search_request architecture is managed by Config Sync.
 */
function immofirst_search_request_install(): void {

}

/**
 * Implements hook_uninstall().
 *
 * Deliberately does NOT delete field_search_criteria, the
 * search_request content type, or any of its fields/data on
 * uninstall — these may be shared with or depended on by other code,
 * and node/config data loss on module uninstall is surprising
 * behavior. Remove manually via config if truly needed.
 */
function immofirst_search_request_uninstall(): void {
}

/**
 * Update hook for sites where the module was already installed before
 * the search_request content type existed.
 *
 * Idempotent and safe to run more than once (e.g. via `drush updb`
 * after a config sync that already brought some of this in some other
 * way) — every piece it creates is guarded by a "does this already
 * exist?" check.
 */
function immofirst_search_request_update_11001(): void {

}

/**
 * Update hook: converts field_criteria from plain text to taxonomy
 * term references, and provisions the "search_criteria" vocabulary +
 * terms behind it.
 *
 * Idempotent: the vocabulary/field/term creation steps are all
 * existence-checked as usual; the field_criteria conversion itself
 * checks the field's current storage type and is a no-op if it has
 * already been converted (see
 * _immofirst_search_request_convert_field_criteria_to_reference()).
 *
 * DATA NOTE: this does NOT migrate any existing search_request nodes'
 * plain-text field_criteria values into taxonomy term references —
 * the old string field (and whatever it holds) is deleted outright.
 * Re-selecting Step 3 checkboxes for pre-existing search requests is
 * out of scope for this refactor; treat it as a separate, explicit
 * data-migration task if it's ever needed.
 */
function immofirst_search_request_update_11002(): void {
 
}

/**
 * Ensures the predefined Search Criteria taxonomy terms exist.
 *
 * Safe to run repeatedly.
 */
function immofirst_search_request_update_11003(): void {
  _immofirst_search_request_install_search_criteria_terms();
}

/**
 * Corrects search_criteria terms seeded from the older
 * ImmoFirst_260826.xlsx transcription so they match the new
 * ImmoFirst_260909.xlsx (Tab.2.1) source of truth:
 *
 * - "Haustiere erlaubt (bei Miete)" is renamed to "Haustiere erlaubt"
 *   and its Gilt-für-Objektart(en) is widened from Wohnung-only to
 *   Wohnung + Haus (the new sheet lists it under both property
 *   types' "Sonstige Kriterien" group).
 * - "Möbliert" and "WG-geeignet" (same "Sonstige Kriterien" group)
 *   likewise gain Haus alongside Wohnung.
 * - "Erschlossen" / "Teilerschlossen" / "Nicht erschlossen" move from
 *   their own "Erschlossen" Group into "Bebauung" — the new sheet has
 *   no separate "Erschlossen" heading; all six Bebauung options
 *   (Sofort bebaubar, Mit Baugenehmigung, Ohne Baubindung,
 *   Erschlossen, Teilerschlossen, Nicht erschlossen) live in one
 *   group.
 *
 * Existing terms are updated in place by (vid, name) lookup rather
 * than recreated, so no duplicates are introduced and each term keeps
 * its term id (and therefore stays valid on any search_request node
 * that already references it via field_criteria). Safe to run more
 * than once.
 */
function immofirst_search_request_update_11004(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  // "Haustiere erlaubt (bei Miete)" -> "Haustiere erlaubt", now shared
  // by Wohnung + Haus. Renamed in place (rather than matched by old
  // name and left alone) so the term id — and therefore any
  // field_criteria reference already pointing at it — survives.
  $renamed = $storage->loadByProperties([
    'vid' => 'search_criteria',
    'name' => 'Haustiere erlaubt (bei Miete)',
  ]);
  foreach ($renamed as $term) {
    $term->setName('Haustiere erlaubt');
    $existing = $term->get('field_property_types')->getValue();
    $values = array_unique(array_merge(array_column($existing, 'value'), ['apartment', 'house']));
    $term->set('field_property_types', array_values($values));
    $term->save();
  }

  // In case a term named "Haustiere erlaubt" already exists (e.g. this
  // update runs on a site where the rename above already happened, or
  // after a partial run), make sure its property types are widened
  // too rather than skipped.
  $alreadyRenamed = $storage->loadByProperties([
    'vid' => 'search_criteria',
    'name' => 'Haustiere erlaubt',
  ]);
  foreach ($alreadyRenamed as $term) {
    $existing = $term->get('field_property_types')->getValue();
    $values = array_unique(array_merge(array_column($existing, 'value'), ['apartment', 'house']));
    if (count($values) !== count($existing)) {
      $term->set('field_property_types', array_values($values));
      $term->save();
    }
  }

  // "Möbliert" and "WG-geeignet": add Haus alongside the existing
  // Wohnung tag.
  foreach (['Möbliert', 'WG-geeignet'] as $label) {
    $terms = $storage->loadByProperties([
      'vid' => 'search_criteria',
      'name' => $label,
      'field_group' => 'Sonstige Kriterien',
    ]);
    foreach ($terms as $term) {
      $existing = $term->get('field_property_types')->getValue();
      $values = array_unique(array_merge(array_column($existing, 'value'), ['apartment', 'house']));
      if (count($values) !== count($existing)) {
        $term->set('field_property_types', array_values($values));
        $term->save();
      }
    }
  }

  // "Erschlossen" / "Teilerschlossen" / "Nicht erschlossen": move from
  // the old standalone "Erschlossen" Group into "Bebauung".
  foreach (['Erschlossen', 'Teilerschlossen', 'Nicht erschlossen'] as $label) {
    $terms = $storage->loadByProperties([
      'vid' => 'search_criteria',
      'name' => $label,
      'field_group' => 'Erschlossen',
    ]);
    foreach ($terms as $term) {
      $term->set('field_group', 'Bebauung');
      $term->save();
    }
  }

  // Finally, create any terms that are missing outright (e.g. a fresh
  // site running this update before 11003 ever ran) using the now-
  // corrected canonical definitions. Existing terms are left alone by
  // the (vid, name, field_group) guard inside this helper.
  _immofirst_search_request_install_search_criteria_terms();
}



/**
 * search_criteria taxonomy term definitions, transcribed verbatim
 * from Tab.2.1 of ImmoFirst_260909.xlsx (supersedes the prior
 * ImmoFirst_260826.xlsx transcription — see
 * immofirst_search_request_update_11004() for the corrections that
 * moved this data onto the new workbook: "Erschlossen" is folded into
 * "Bebauung" rather than kept as its own heading, and "Haustiere
 * erlaubt" drops the "(bei Miete)" suffix and is now shared by
 * Wohnung + Haus, per Sonstige Kriterien in the new sheet).
 * "Beim Kauf" is still an internal condition rather than a checkbox
 * or heading, exactly as before. Deduplicated across
 * property types: a label that's identical AND under the same Group
 * heading for more than one Objektart (e.g. every "Bonität &
 * zusätzliche Angaben" option, shared by all five property types)
 * becomes ONE term with multiple 'property_types' entries, rather
 * than one duplicate term per property type — see
 * SearchCriteriaTermRepository, which filters by 'property_types'.
 *
 * 'weight' preserves the workbook's own top-to-bottom option order
 * (taxonomy_term's native "weight" field — no separate field needed);
 * gaps of 10 between values just leave room to insert a term later
 * without renumbering everything else.
 *
 * "Beim Kauf" itself is intentionally absent below — per the
 * workbook's note it's an internal sub-category condition, not a
 * checkbox and not a heading, so no term or Group value is ever
 * created for it. Its three real options ("Finanzierung gesichert",
 * "Eigenkapital vorhanden", "Kauf ohne Finanzierung möglich") ARE
 * created as normal terms in "Bonität & zusätzliche Angaben" —
 * SearchRequestWizardForm::filterCriteriaOptionsForRequestType()
 * still only shows them for Kaufen, exactly as before.
 *
 * @return array<int, array{label: string, group: string, weight: int, property_types: string[]}>
 */
