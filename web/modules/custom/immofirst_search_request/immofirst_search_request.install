<?php

declare(strict_types=1);

/**
 * @file
 * Install/uninstall hooks for the ImmoFirst Search Request module.
 *
 * ARCHITECTURE NOTE (Phase 1 of the suchauftrag/search_request split):
 * Buyer/tenant search requests created by the wizard were originally
 * stored as "suchauftrag" nodes (a content type meant for provider
 * property LISTINGS), with all wizard answers besides a handful of
 * legacy fields flattened into one field_search_criteria JSON blob.
 * That is being corrected: a dedicated "search_request" content type
 * with one real Drupal field per wizard answer is introduced below.
 *
 * Phase 1 scope is structural only:
 * - immofirst_search_request_install() (suchauftrag / legacy JSON
 *   field) is UNCHANGED — nothing is removed from or added to
 *   suchauftrag, and no suchauftrag data is touched.
 * - _immofirst_search_request_install_search_request_type() ADDS the
 *   new search_request content type and its fields, wired up for
 *   fresh installs (hook_install) and already-installed sites
 *   (hook_update_11001) alike.
 * - The wizard form, its AJAX flow, and SearchRequestNodeCreator still
 *   read/write "suchauftrag" exactly as before. Pointing node creation
 *   at "search_request" is a later phase, not part of this change.
 */

use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 *
 * Only provisions the legacy JSON field used by the original
 * "suchauftrag" wizard. All structural configuration for the
 * search_request architecture is managed by Config Sync.
 */
function immofirst_search_request_install(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_search_criteria')) {
    FieldStorageConfig::create([
      'field_name' => 'field_search_criteria',
      'entity_type' => 'node',
      'type' => 'string_long',
      'translatable' => TRUE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'suchauftrag', 'field_search_criteria')) {
    FieldConfig::create([
      'field_name' => 'field_search_criteria',
      'entity_type' => 'node',
      'bundle' => 'suchauftrag',
      'label' => 'Suchkriterien (JSON)',
      'description' => 'Legacy wizard JSON payload.',
      'required' => FALSE,
    ])->save();
  }
}

/**
 * Implements hook_uninstall().
 *
 * Deliberately does NOT delete field_search_criteria, the
 * search_request content type, or any of its fields/data on
 * uninstall — these may be shared with or depended on by other code,
 * and node/config data loss on module uninstall is surprising
 * behavior. Remove manually via config if truly needed.
 */
function immofirst_search_request_uninstall(): void {
}

/**
 * Update hook for sites where the module was already installed before
 * the search_request content type existed.
 *
 * Idempotent and safe to run more than once (e.g. via `drush updb`
 * after a config sync that already brought some of this in some other
 * way) — every piece it creates is guarded by a "does this already
 * exist?" check.
 */
function immofirst_search_request_update_11001(): void {

}

/**
 * Update hook: converts field_criteria from plain text to taxonomy
 * term references, and provisions the "search_criteria" vocabulary +
 * terms behind it.
 *
 * Idempotent: the vocabulary/field/term creation steps are all
 * existence-checked as usual; the field_criteria conversion itself
 * checks the field's current storage type and is a no-op if it has
 * already been converted (see
 * _immofirst_search_request_convert_field_criteria_to_reference()).
 *
 * DATA NOTE: this does NOT migrate any existing search_request nodes'
 * plain-text field_criteria values into taxonomy term references —
 * the old string field (and whatever it holds) is deleted outright.
 * Re-selecting Step 3 checkboxes for pre-existing search requests is
 * out of scope for this refactor; treat it as a separate, explicit
 * data-migration task if it's ever needed.
 */
function immofirst_search_request_update_11002(): void {
 
}

/**
 * Ensures the predefined Search Criteria taxonomy terms exist.
 *
 * Safe to run repeatedly.
 */
function immofirst_search_request_update_11003(): void {
  _immofirst_search_request_install_search_criteria_terms();
}



/**
 * search_criteria taxonomy term definitions, transcribed verbatim
