/**
 * Creates search_criteria taxonomy terms from
 * _immofirst_search_request_criteria_term_definitions(), skipping any
 * (label, Group) pair that already exists so this can be re-run
 * safely (e.g. after a config sync, or a partially-failed update).
 */
function _immofirst_search_request_install_search_criteria_terms(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  foreach (_immofirst_search_request_criteria_term_definitions() as $definition) {
    $existing = $storage->loadByProperties([
      'vid' => 'search_criteria',
      'name' => $definition['label'],
      'field_group' => $definition['group'],
    ]);

    if ($existing) {
      continue;
    }

    $storage->create([
      'vid' => 'search_criteria',
      'name' => $definition['label'],
      'weight' => $definition['weight'],
      'field_group' => $definition['group'],
      'field_property_types' => $definition['property_types'],
    ])->save();
  }
}

/**
 * The dedicated SQL tables field_criteria could have, as a plain
 * 'string' field on the (revisionable) 'node' entity type.
 *
 * Both are listed unconditionally — whether each one PHYSICALLY
 * exists on a given site is checked separately via the schema API
 * (see _immofirst_search_request_purge_field_criteria_tables()) —
 * this constant is just "the two names to check", not a claim that
 * both are present.
 *
 * @return string[]
 */
function _immofirst_search_request_field_criteria_table_names(): array {
  return ['node__field_criteria', 'node_revision__field_criteria'];
}

/**
 * Deletes any remaining field_criteria row data from whichever of its
 * dedicated tables actually exist on THIS site.
 *
 * BUG CONTEXT: FieldStorageConfig::isRevisionable() derives its
 * answer from the ENTITY TYPE ('node' is revisionable), not from
 * which dedicated tables were actually created for this specific
 * field. On a site where field_criteria's schema has drifted from its
 * config (e.g. a config import that skipped the corresponding entity
 * schema update), only node__field_criteria may physically exist,
 * with no node_revision__field_criteria table at all. Core's field
 * purge path doesn't check for that before querying the revision
 * table, so cleaning up ourselves first — strictly guarded by
 * $schema->tableExists() — avoids ever issuing a query against a
 * table that isn't there.
 *
 * Idempotent: a table that doesn't exist, or is already empty, is
 * simply skipped.
 */
function _immofirst_search_request_purge_field_criteria_tables(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  foreach (_immofirst_search_request_field_criteria_table_names() as $table) {
    if (!$schema->tableExists($table)) {
      // Never query a table before confirming it exists — on this
      // site, that's expected for node_revision__field_criteria.
      continue;
    }

    $database->delete($table)->execute();
  }
}

/**
 * Deletes the old field_criteria FieldConfig + FieldStorageConfig and
 * purges it, tolerating a site where its DB schema has drifted from
 * what Drupal core's field-deletion path assumes (see
 * _immofirst_search_request_purge_field_criteria_tables()).
 *
 * Core's $storage->delete() and field_purge_batch() build their own
 * table names from the field's storage DEFINITION (which, per the bug
 * above, unconditionally believes a revision table exists for any
 * field on a revisionable entity type) rather than from the schema
 * API — so even after we've pre-cleaned every table that's actually
 * present, core can still attempt a query against a table that isn't
 * there. We can't add an existence check inside core, so the raw DB
 * "table doesn't exist" exception is caught here specifically (never
 * a bare catch-all) and logged: our own manual purge above already
 * did the real cleanup work, so a core-side purge failure on a
 * missing table is a known, harmless no-op for this site, not a
 * reason to fail the whole update.
 */
function _immofirst_search_request_delete_and_purge_field_criteria(FieldStorageConfig $storage): void {
  FieldConfig::loadByName('node', 'search_request', 'field_criteria')?->delete();

  _immofirst_search_request_purge_field_criteria_tables();

  try {
    $storage->delete();

    // Field deletion only marks storage/values for removal; a field
    // name can't be reused until that's actually purged, which
    // normally happens later via cron. Purge synchronously here
    // instead, so field_criteria can be recreated in this same
    // request. Bounded, not infinite: a purge batch this large is
    // more than enough for this field's realistic data volume — run
    // this update again (it's idempotent) if it's ever not.
    for ($i = 0; $i < 20; $i++) {
      field_purge_batch(200);
    }
  }
  catch (\Drupal\Core\Database\DatabaseExceptionWrapper $e) {
    // Core tried to touch a dedicated table (almost certainly
    // node_revision__field_criteria) that doesn't physically exist on
    // this site. We've already purged every table that does exist
    // above, so there's nothing left to lose here — log it and let
    // the update carry on to recreate field_criteria as a reference
    // field, rather than aborting the whole `drush updb` run.
    \Drupal::logger('immofirst_search_request')->warning(
      'field_criteria delete/purge hit a missing dedicated table (schema drift) — continuing, since data was already purged from every table that does exist. Original error: @message',
      ['@message' => $e->getMessage()],
    );
  }
}

/**
 * Converts search_request's field_criteria from plain text
 * (unlimited 'string') to an entity_reference (unlimited, to
 * taxonomy_term) targeting the "search_criteria" vocabulary.
 *
 * A field's TYPE cannot be changed in place via the Field API — the
 * only supported path is deleting the old field storage (and its
 * bundle instance) and creating a new one under the same name. That
 * means any existing field_criteria VALUES (plain-text strings on
 * already-saved search_request nodes) are discarded, not migrated;
 * see the DATA NOTE on immofirst_search_request_update_11002().
 *
 * Idempotent and safe on both revisionable and non-revisionable
 * field_criteria schemas:
 * - No-op if field_criteria is already an entity_reference (e.g. a
 *   fresh install that never had the old string field, or a second
 *   run of this same update).
 * - Every direct table reference is guarded by
 *   $schema->tableExists() (see
 *   _immofirst_search_request_purge_field_criteria_tables()) — a
 *   missing node_revision__field_criteria table is treated as "this
 *   field was never revisioned here", not an error.
 * - If field_criteria still can't be recreated after cleanup (e.g.
 *   purge left it in an unexpected state this function couldn't
 *   resolve), a descriptive exception is thrown rather than silently
 *   creating a duplicate or inconsistent field, matching this
 *   module's existing error-handling pattern (see
 *   _immofirst_search_request_ensure_field_storage()).
 */
function _immofirst_search_request_convert_field_criteria_to_reference(): void {
  $storage = FieldStorageConfig::loadByName('node', 'field_criteria');

  if ($storage && $storage->getType() === 'entity_reference') {
    return;
  }

  if ($storage) {
    _immofirst_search_request_delete_and_purge_field_criteria($storage);

    if (FieldStorageConfig::loadByName('node', 'field_criteria')) {
      throw new \RuntimeException('field_criteria still exists as the old field after delete + purge. Its dedicated tables may need manual cleanup (see the schema-drift note on _immofirst_search_request_delete_and_purge_field_criteria()) before this update can recreate it as an entity_reference.');
    }
  }

  if (!FieldStorageConfig::loadByName('node', 'field_criteria')) {
    FieldStorageConfig::create([
      'field_name' => 'field_criteria',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
      'settings' => ['target_type' => 'taxonomy_term'],
      'translatable' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'search_request', 'field_criteria')) {
    FieldConfig::create([
      'field_name' => 'field_criteria',
      'entity_type' => 'node',
      'bundle' => 'search_request',
      'label' => 'Zusätzliche Kriterien',
      'description' => 'Step 3 checkbox selections, stored as references to search_criteria taxonomy terms (see SearchCriteriaTermRepository) — not plain text.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => ['search_criteria' => 'search_criteria'],
        ],
      ],
    ])->save();
  }
}
