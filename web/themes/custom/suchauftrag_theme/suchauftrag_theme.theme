<?php

/**
 * @file
 * Functions to support theming in the Suchauftrag theme.
 */

use Drupal\Core\Template\Attribute;

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function suchauftrag_theme_preprocess_page(array &$variables) {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');

  // Primary navigation links used by includes/header.html.twig.
  $variables['main_nav_links'] = [
    ['title' => 'Suchaufträge', 'url' => '/suchauftraege', 'active' => TRUE],
    ['title' => 'Suchauftrag erstellen', 'url' => '/suchauftrag/erstellen', 'active' => FALSE],
    ['title' => "So funktioniert's", 'url' => '/so-funktionierts', 'active' => FALSE],
    ['title' => 'Über uns', 'url' => '/ueber-uns', 'active' => FALSE],
    ['title' => 'FAQ', 'url' => '/faq', 'active' => FALSE],
  ];
  $request = \Drupal::request();

  $variables['search_query'] = [
    'art' => $request->query->get('art', 'mieten'),
    'immobilienart' => $request->query->get('immobilienart', ''),
    'ort' => $request->query->get('ort', ''),
    'radius' => $request->query->get('radius', '25'),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page--front.html.twig data.
 */
function suchauftrag_theme_preprocess_page__front(array &$variables) {
  suchauftrag_theme_preprocess_page($variables);

  // Read the search form's submitted GET parameters and pass them to the
  // View as its exposed input.
  //
  // suchauftrag_theme_views_pre_view() further down this file was written
  // to do exactly this, but hook_views_pre_view() is a general-purpose
  // hook — Drupal's ModuleHandler only scans enabled MODULES for it
  // (invokeAll() -> getImplementationInfo() iterates $this->moduleList
  // only), never theme .theme files. So that function has always been
  // dead code: it silently never ran, the View's exposed input was
  // always empty, and every request returned the same unfiltered
  // (newest-first, first 6) results regardless of the URL. It has been
  // removed below in favor of this fix, which lives in a hook Drupal
  // DOES invoke for themes (preprocess hooks) and runs early enough
  // (before the view is built/executed) to actually affect filtering.
  //
  // Only genuinely-provided, non-empty values are passed through — an
  // absent or empty-string query parameter must mean "no filter on this
  // field", never "filter for an empty value" (which would incorrectly
  // hide every result, since no node has e.g. field_request_type_value
  // stored as an empty string).
  $request = \Drupal::request();
  $exposed_input = [];
  foreach (['art', 'immobilienart', 'ort'] as $filter_identifier) {
    $value = $request->query->get($filter_identifier);
    if ($value !== NULL && $value !== '') {
      $exposed_input[$filter_identifier] = $value;
    }
  }

  // Build + execute the Search Requests view ONCE, with that exposed
  // input, and reuse the same executed $view for both the rendered
  // block (search_requests_view, printed in page--front.html.twig) and
  // the result count (search_requests_count) — rather than the previous
  // code's two separate, independently-unfiltered Views::getView() calls
  // for the same view. This guarantees the count badge and the actual
  // results are always counting/showing the exact same filtered set.
  $variables['search_requests_view'] = [];
  $variables['search_requests_count'] = 0;

  $view = \Drupal\views\Views::getView('search_requests');
  if ($view && $view->access('block_1')) {
    $view->setDisplay('block_1');
    $view->setExposedInput($exposed_input);
    $variables['search_requests_view'] = $view->preview('block_1');
    $variables['search_requests_count'] = $view->total_rows ?? count($view->result);
  }

  // Feature icon row content (editable later via block config).
  $variables['feature_icons'] = [
    [
      'icon' => 'shield',
      'title' => 'Direkter Kontakt',
      'text' => 'Treten Sie direkt mit Suchkunden in Kontakt.',
      'color' => 'green',
    ],
    [
      'icon' => 'target',
      'title' => 'Aktuelle Gesuche',
      'text' => 'Täglich neue Suchaufträge von geprüften Interessenten.',
      'color' => 'indigo',
    ],
    [
      'icon' => 'lock',
      'title' => 'Kostenlos & unverbindlich',
      'text' => 'Angebote einstellen ist für Sie kostenlos.',
      'color' => 'purple',
    ],
    [
      'icon' => 'clock',
      'title' => 'Zeit sparen',
      'text' => 'Finden Sie passende Anfragen in Ihrer Region.',
      'color' => 'amber',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the property-card component.
 */
function suchauftrag_theme_preprocess_property_card(array &$variables) {
  if (!empty($variables['request_type']) && $variables['request_type'] === 'kaufen') {
    $variables['badge_class'] = 'badge--buy';
  }
  else {
    $variables['badge_class'] = 'badge--rent';
  }
}

/**
 * Implements hook_preprocess_HOOK() for the search_requests view's
 * unformatted row style.
 *
 * Builds one `property_card` render array per row and exposes them as
 * $property_cards, so the Twig template can simply print each one
 * ({{ card }}) instead of calling a "theme()" Twig function — which,
 * like drupal_view(), does not exist in core Twig without the contrib
 * Twig Tweak module. This keeps the theme dependency-free.
 *
 * IMPORTANT: adjust the field machine names below once the real
 * "search_requests" View/content type exists (see the comments in
 * templates/views/views-view-unformatted--search-requests.html.twig).
 */
function suchauftrag_theme_preprocess_views_view_unformatted__search_requests(array &$variables) {
  $variables['property_cards'] = [];

  foreach ($variables['rows'] as $id => $row) {
    // The "entity:node" row plugin normally exposes the raw ResultRow
    // (with its ->_entity property) at $row['content']['#row']. As a
    // fallback for any Views internals differences, also try pulling
    // the entity straight from the executed view's result array.
    $node = $row['content']['#row']->_entity
      ?? $variables['view']->result[$id]->_entity
      ?? NULL;

    if (!$node) {
      continue;
    }

    $type = $node->hasField('field_request_type') && !$node->get('field_request_type')->isEmpty()
      ? $node->get('field_request_type')->value
      : 'mieten';

    $get = function (string $field) use ($node) {
      return $node->hasField($field) && !$node->get($field)->isEmpty()
        ? $node->get($field)->value
        : '';
    };

    // Format field_request_date (stored as Y-m-d) into "Heute" / "Gestern"
    // / "d.m.Y", matching the reference design's card header.
    $date_label = '';
    $raw_date = $get('field_request_date');
    if ($raw_date) {
      try {
        $date = new \DateTime($raw_date);
        $today = new \DateTime('today');
        $yesterday = new \DateTime('yesterday');
        if ($date->format('Y-m-d') === $today->format('Y-m-d')) {
          $date_label = 'Heute';
        }
        elseif ($date->format('Y-m-d') === $yesterday->format('Y-m-d')) {
          $date_label = 'Gestern';
        }
        else {
          $date_label = $date->format('d.m.Y');
        }
      }
      catch (\Exception $e) {
        $date_label = $raw_date;
      }
    }

    $variables['property_cards'][$id] = [
      '#theme' => 'property_card',
      // IMPORTANT: every variable key below MUST be '#'-prefixed.
      // This array is processed by Drupal's Renderer (not a plain Twig
      // include), and the Renderer treats any NON-'#' key as a child
      // render element that must itself be an array — passing a scalar
      // there throws "... is an invalid render array key" (Element::children()).
      // Also note: the property is named '#request_type', not '#type' —
      // '#type' is a reserved Render API property (element plugin ID)
      // and using it here would collide with that system, not our data.
      '#request_type' => $type,
      '#badge_label' => $type === 'kaufen' ? 'KAUFEN' : 'MIETEN',
      '#date' => $date_label,
      '#icon' => $get('field_property_icon') ?: 'home',
      '#title' => $node->label(),
      '#location' => $get('field_location'),
      '#area' => $get('field_area'),
      '#rooms' => $get('field_rooms'),
      '#price' => $get('field_price'),
      '#description' => $get('field_description'),
      '#details_url' => $node->toUrl()->toString(),
      '#offer_url' => $node->toUrl()->toString() . '/angebot',
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK() for node--search-request.html.twig.
 *
 * DATA SOURCE: reads only the persisted $node's own fields — never the
 * wizard's PrivateTempStore session (SearchRequestSession is not
 * touched or referenced here). Field machine names below are exactly
 * those confirmed in the architecture inspection report (not guessed):
 * field_request_type, field_property_type, field_location,
 * field_radius, field_area_min/max, field_rooms_min/max,
 * field_price_min/max, field_construction_year,
 * field_land_size_min/max, field_usage, field_parking_type,
 * field_vehicle_type, field_commercial_type, field_criteria,
 * field_notes, field_reference_number, field_status. The
 * search_criteria taxonomy term fields used below (field_group, the
 * plain string "Group"; field_property_types, "Gilt für
 * Objektart(en)") are likewise taken as confirmed, not assumed.
 *
 * No business logic (SearchRequestWizardForm, SearchRequestNodeCreator,
 * SearchCriteriaTermRepository, session storage, AJAX, node creation,
 * taxonomy/field configuration) is modified or duplicated here — this
 * only reads already-persisted data for display.
 */
function suchauftrag_theme_preprocess_node__search_request(array &$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  // Local helper: NULL for a missing/empty field, its value otherwise —
  // used throughout so "do not display empty fields" is enforced at a
  // single point rather than repeated per field.
  $get = function (string $field_name) use ($node): ?string {
    return $node->hasField($field_name) && !$node->get($field_name)->isEmpty()
      ? $node->get($field_name)->value
      : NULL;
  };

  $request_type = $get('field_request_type') ?? 'mieten';
  $property_type = $get('field_property_type') ?? 'apartment';

  $request_type_labels = [
    'kaufen' => 'Kaufen',
    'mieten' => 'Mieten',
  ];
  $property_type_labels = [
    'apartment' => 'Wohnung',
    'house' => 'Haus',
    'land' => 'Grundstück',
    'garage' => 'Garage / Stellplatz',
    'commercial' => 'Gewerbe',
  ];

  $variables['request_type'] = $request_type;
  $variables['request_type_label'] = $request_type_labels[$request_type] ?? ucfirst($request_type);
  $variables['property_type'] = $property_type;
  $variables['property_type_label'] = $property_type_labels[$property_type] ?? ucfirst($property_type);
  $variables['location'] = $get('field_location');
  $variables['radius'] = $get('field_radius');

  // ===== Property-specific requirements row =====
  // Section 5/6 of the spec: only the fields that apply to the
  // selected property_type, in the given order, and only when
  // actually set. Kaufpreis/Kaltmiete uses the SAME field_price_min/
  // field_price_max pair for every property type ("where applicable")
  // — just a different label depending on field_request_type.
  $price_label = $request_type === 'kaufen' ? 'Kaufpreis' : 'Kaltmiete';
  $price_range = _suchauftrag_theme_format_price($get('field_price_min'), $get('field_price_max'));

  $requirements = [];
  switch ($property_type) {
    case 'apartment':
      if ($range = _suchauftrag_theme_format_range($get('field_area_min'), $get('field_area_max'), 'm²')) {
        $requirements[] = ['icon' => 'area', 'value' => $range, 'label' => 'Wohnfläche'];
      }
      if ($range = _suchauftrag_theme_format_range($get('field_rooms_min'), $get('field_rooms_max'), NULL)) {
        $requirements[] = ['icon' => 'rooms', 'value' => $range, 'label' => 'Zimmer'];
      }
      if ($price_range) {
        $requirements[] = ['icon' => 'price', 'value' => $price_range, 'label' => $price_label];
      }
      if ($year = $get('field_construction_year')) {
        $requirements[] = ['icon' => 'year', 'value' => _suchauftrag_theme_format_construction_year($year), 'label' => 'Baujahr'];
      }
      break;

    case 'house':
      if ($range = _suchauftrag_theme_format_range($get('field_area_min'), $get('field_area_max'), 'm²')) {
        $requirements[] = ['icon' => 'area', 'value' => $range, 'label' => 'Wohnfläche'];
      }
      if ($range = _suchauftrag_theme_format_range($get('field_rooms_min'), $get('field_rooms_max'), NULL)) {
        $requirements[] = ['icon' => 'rooms', 'value' => $range, 'label' => 'Zimmer'];
      }
      if ($price_range) {
        $requirements[] = ['icon' => 'price', 'value' => $price_range, 'label' => $price_label];
      }
      if ($year = $get('field_construction_year')) {
        $requirements[] = ['icon' => 'year', 'value' => _suchauftrag_theme_format_construction_year($year), 'label' => 'Baujahr'];
      }
      if ($range = _suchauftrag_theme_format_range($get('field_land_size_min'), $get('field_land_size_max'), 'm²')) {
        $requirements[] = ['icon' => 'land', 'value' => $range, 'label' => 'Grundstück'];
      }
      break;

    case 'land':
      if ($range = _suchauftrag_theme_format_range($get('field_land_size_min'), $get('field_land_size_max'), 'm²')) {
        $requirements[] = ['icon' => 'land', 'value' => $range, 'label' => 'Grundstücksfläche'];
      }
      if ($price_range) {
        $requirements[] = ['icon' => 'price', 'value' => $price_range, 'label' => $price_label];
      }
      if ($usage = $get('field_usage')) {
        $requirements[] = ['icon' => 'usage', 'value' => $usage, 'label' => 'Nutzung'];
      }
      break;

    case 'garage':
      if ($parking = $get('field_parking_type')) {
        $requirements[] = ['icon' => 'parking', 'value' => $parking, 'label' => 'Stellplatzart'];
      }
      if ($vehicle = $get('field_vehicle_type')) {
        $requirements[] = ['icon' => 'vehicle', 'value' => $vehicle, 'label' => 'Fahrzeugtyp'];
      }
      if ($price_range) {
        $requirements[] = ['icon' => 'price', 'value' => $price_range, 'label' => $price_label];
      }
      break;

    case 'commercial':
      // "Gewerbe already exists in the implementation" (field_commercial_type) —
      // read here, not re-implemented.
      if ($commercial = $get('field_commercial_type')) {
        $requirements[] = ['icon' => 'commercial', 'value' => $commercial, 'label' => 'Art der Gewerbeimmobilie'];
      }
      if ($range = _suchauftrag_theme_format_range($get('field_area_min'), $get('field_area_max'), 'm²')) {
        $requirements[] = ['icon' => 'area', 'value' => $range, 'label' => 'Fläche'];
      }
      if ($price_range) {
        $requirements[] = ['icon' => 'price', 'value' => $price_range, 'label' => $price_label];
      }
      break;
  }
  $variables['requirements'] = $requirements;

  // ===== Criteria, grouped by the term's field_group =====
  // field_criteria (untouched, existing entity reference field) →
  // search_criteria taxonomy terms → grouped by each term's
  // "Group" (field_group). "Gilt für Objektart(en)"
  // (field_property_types) already constrained which terms were
  // offered in the wizard for this property_type, so it does not need
  // to be re-checked here — every referenced term is, by construction,
  // applicable. The 3 purchase-only terms are defensively re-excluded
  // for Mieten (see inspection report §7: the wizard's render-time
  // array_diff() filter is the only current gate, with no
  // validateForm()/submitForm() re-check) — this is a display-time
  // safeguard only, no taxonomy/field data is modified.
  $purchase_only_labels = [
    'Finanzierung gesichert',
    'Eigenkapital vorhanden',
    'Kauf ohne Finanzierung möglich',
  ];

  $grouped = [];
  if ($node->hasField('field_criteria') && !$node->get('field_criteria')->isEmpty()) {
    foreach ($node->get('field_criteria')->referencedEntities() as $term) {
      if (!$term instanceof \Drupal\taxonomy\TermInterface) {
        continue;
      }

      $label = $term->label();
      if ($request_type !== 'kaufen' && in_array($label, $purchase_only_labels, TRUE)) {
        continue;
      }

      $group_label = $term->hasField('field_group') && !$term->get('field_group')->isEmpty()
        ? $term->get('field_group')->value
        : NULL;
      // "Beim Kauf" is never a term/heading at all (confirmed in the
      // inspection report), so there is nothing to specifically
      // suppress for it here — an ungrouped term simply has no sane
      // heading to render under and is skipped rather than inventing one.
      if ($group_label === NULL) {
        continue;
      }

      $grouped[$group_label][] = $label;
    }
  }

  $variables['criteria_groups'] = [];
  foreach ($grouped as $group_label => $items) {
    $variables['criteria_groups'][] = ['label' => $group_label, 'items' => $items];
  }

  // ===== Notes =====
  $variables['notes'] = $get('field_notes');

  // ===== Metadata =====
  $variables['reference_number'] = $get('field_reference_number');
  $variables['created_date'] = \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'd.m.Y');

  $status_labels = ['new' => 'Neu'];
  $status = $get('field_status');
  $variables['status_label'] = $status !== NULL ? ($status_labels[$status] ?? ucfirst($status)) : NULL;

  // "Gesucht seit X Tagen" — derived purely from the base `created`
  // field. No custom request-date field is ever written by
  // SearchRequestNodeCreator (confirmed in the inspection report:
  // field_request_date is read by the OLD views preprocess below but
  // never set), so nothing here relies on that field.
  $days_ago = (int) floor((\Drupal::time()->getRequestTime() - $node->getCreatedTime()) / 86400);
  $variables['days_ago_label'] = match (TRUE) {
    $days_ago <= 0 => 'Heute eingestellt',
    $days_ago === 1 => 'Gesucht seit 1 Tag',
    default => 'Gesucht seit ' . $days_ago . ' Tagen',
  };
}

/**
 * Formats a min/max pair as "70 – 80 m²" / "ab 70 m²" / "bis 80 m²".
 *
 * Used for the (decimal-as-string) area/rooms/land-size field pairs.
 * Returns NULL when both bounds are empty, so the caller can skip
 * rendering the row entirely ("do not display empty fields").
 */
function _suchauftrag_theme_format_range(?string $min, ?string $max, ?string $unit): ?string {
  $format_number = static function (?string $value): ?string {
    if ($value === NULL || $value === '' || !is_numeric($value)) {
      return NULL;
    }
    // Decimal-as-string fields (e.g. field_rooms_min) commonly carry a
    // trailing ".0" — drop it so whole numbers show as "3", not "3.0".
    $float = (float) $value;
    return $float == (int) $float ? (string) (int) $float : rtrim(rtrim((string) $float, '0'), '.');
  };

  $min_formatted = $format_number($min);
  $max_formatted = $format_number($max);
  if ($min_formatted === NULL && $max_formatted === NULL) {
    return NULL;
  }

  // Defensive display-only fix: if both bounds are present but stored
  // out of order (e.g. min > max due to a data-entry mistake upstream,
  // with no validation currently enforcing order — see inspection
  // report §7), swap them for display so the range always reads
  // low-to-high. This does not touch the stored field values or any
  // wizard/node-creation logic, only how this preprocess renders them.
  if ($min_formatted !== NULL && $max_formatted !== NULL && (float) $min > (float) $max) {
    [$min_formatted, $max_formatted] = [$max_formatted, $min_formatted];
  }

  $suffix = $unit ? ' ' . $unit : '';
  if ($min_formatted !== NULL && $max_formatted !== NULL) {
    return $min_formatted . ' – ' . $max_formatted . $suffix;
  }
  return $min_formatted !== NULL
    ? 'ab ' . $min_formatted . $suffix
    : 'bis ' . $max_formatted . $suffix;
}

/**
 * Formats a min/max price pair as "300 – 400 €" / "ab 300 €" / "bis 400 €".
 *
 * Kept separate from _suchauftrag_theme_format_range() because prices
 * need German thousands-separator formatting (number_format), not the
 * plain-integer/decimal handling that field suffices for area/rooms.
 * Returns NULL when both bounds are empty.
 */
function _suchauftrag_theme_format_price(?string $min, ?string $max): ?string {
  $format_currency = static function (?string $value): ?string {
    return ($value !== NULL && $value !== '' && is_numeric($value))
      ? number_format((float) $value, 0, ',', '.')
      : NULL;
  };

  $min_formatted = $format_currency($min);
  $max_formatted = $format_currency($max);
  if ($min_formatted === NULL && $max_formatted === NULL) {
    return NULL;
  }

  // Same defensive display-only ordering fix as
  // _suchauftrag_theme_format_range() — see the comment there.
  if ($min_formatted !== NULL && $max_formatted !== NULL && (float) $min > (float) $max) {
    [$min_formatted, $max_formatted] = [$max_formatted, $min_formatted];
  }

  if ($min_formatted !== NULL && $max_formatted !== NULL) {
    return $min_formatted . ' – ' . $max_formatted . ' €';
  }
  return ($min_formatted !== NULL ? 'ab ' . $min_formatted : 'bis ' . $max_formatted) . ' €';
}

/**
 * Formats a stored field_construction_year value into a readable label.
 *
 * BUG FIX: the detail page was printing this field's raw machine value
 * verbatim (e.g. "bis_1970" shown on screen), because no field storage
 * config ships in this repo to confirm its allowed-values list (see
 * inspection report: field storage lives in Config Sync, not in
 * either archive) — so no label map was ever built for it. Rather
 * than guess at unconfirmed taxonomy/allowed-value labels, this does
 * a generic, safe transform of the underscore-separated machine value
 * into the human formatting already used elsewhere on this page
 * (e.g. "bis 1970", "ab 2010", "2010 – heute"). Already-human values
 * (no underscore) pass through unchanged.
 */
function _suchauftrag_theme_format_construction_year(string $value): string {
  if (!str_contains($value, '_')) {
    return $value;
  }

  $parts = explode('_', $value);

  // "bis_1970" / "ab_2010" -> "bis 1970" / "ab 2010".
  if (count($parts) === 2 && in_array($parts[0], ['bis', 'ab'], TRUE)) {
    return $parts[0] . ' ' . $parts[1];
  }

  // "2010_heute" -> "2010 – heute"; "1970_1990" -> "1970 – 1990".
  if (count($parts) === 2) {
    return $parts[0] . ' – ' . $parts[1];
  }

  // Fallback: just make it readable.
  return ucfirst(str_replace('_', ' ', $value));
}

/**
 * Implements hook_theme().
 *
 * Registers the reusable components as themeable render elements so they
 * can be invoked from views, preprocess functions, or other templates via
 * theme('property_card', [...]) etc.
 */
function suchauftrag_theme_theme($existing, $type, $theme, $path) {
  return [
    'property_card' => [
      'variables' => [
        'request_type' => 'mieten',
        'badge_label' => 'MIETEN',
        'date' => '',
        'icon' => 'home',
        'title' => '',
        'location' => '',
        'area' => '',
        'rooms' => '',
        'price' => '',
        'description' => '',
        'details_url' => '#',
        'offer_url' => '#',
      ],
      'template' => 'components/property-card',
    ],
    'search_form' => [
      'variables' => [],
      'template' => 'components/search-form',
    ],
    'filter_select' => [
      'variables' => [
        'label' => '',
        'name' => '',
        'options' => [],
        'selected' => '',
      ],
      'template' => 'components/filter-select',
    ],
    'button' => [
      'variables' => [
        'text' => '',
        'url' => '#',
        'variant' => 'primary',
        'icon' => NULL,
      ],
      'template' => 'components/button',
    ],
    'badge' => [
      'variables' => [
        'label' => '',
        'variant' => 'rent',
      ],
      'template' => 'components/badge',
    ],
    'stat_item' => [
      'variables' => [
        'icon' => '',
        'value' => '',
        'label' => '',
      ],
      'template' => 'components/stat-item',
    ],
  ];
}

/*
 * NOTE: this file previously had a suchauftrag_theme_views_pre_view()
 * implementation here, written to feed the search form's GET parameters
 * into the search_requests View's exposed input. It has been removed:
 * hook_views_pre_view() is a general-purpose hook, and Drupal's
 * ModuleHandler only ever scans enabled MODULES for it — never theme
 * .theme files — so it silently never ran. The same fix now lives in
 * suchauftrag_theme_preprocess_page__front() above, in a hook Drupal
 * actually invokes for themes.
 */
