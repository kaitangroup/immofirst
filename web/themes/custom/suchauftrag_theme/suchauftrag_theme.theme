/**
 * Implements hook_form_alter().
 */
function suchauftrag_theme_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id) {
  if (str_starts_with($form_id, 'webform_submission_offer_to_search_request')) {
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Angebot senden');
      $form['actions']['submit']['#type'] = 'button';
      $form['actions']['submit']['#attributes']['type'] = 'submit';
    }

    if (isset($form['elements']['name'])) {
      $form['elements']['name']['#required_error'] = t('Bitte geben Sie Ihren Namen ein.');
    }
    if (isset($form['elements']['email'])) {
      $form['elements']['email']['#required_error'] = t('Bitte geben Sie Ihre E-Mail-Adresse ein.');
    }
    if (isset($form['elements']['phone'])) {
      $form['elements']['phone']['#required_error'] = t('Bitte geben Sie Ihre Telefonnummer ein.');
    }
  }
}
