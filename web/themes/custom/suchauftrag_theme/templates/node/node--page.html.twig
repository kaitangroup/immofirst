{#
/**
 * @file
 * Basic page (node type "page") — e.g. /impressum, /datenschutz, /agb.
 *
 * The page title block (suchauftrag_theme_page_title) is disabled
 * site-wide, so the full view prints the node title itself as the
 * page's only <h1>, followed by the intro text (body content before the
 * first <h2>) and a white card with one divided row per <h2> section.
 * `intro`, `sections` and `variant` come from
 * suchauftrag_theme_preprocess_node__page(); a body without <h2>s
 * renders unchanged inside the card. Other view modes fall back to a
 * linked <h2> title, like core's node.html.twig. Styling lives in the
 * "basic-page" library so no other page's CSS changes.
 */
#}
{{ attach_library('suchauftrag_theme/basic-page') }}
{% if page %}
  <article{{ attributes.addClass('basic-page', variant ? 'basic-page--' ~ variant) }}>
    <header class="basic-page__header">
      {{ title_prefix }}
      <h1{{ title_attributes.addClass('basic-page__title') }}>{{ label }}</h1>
      {{ title_suffix }}
      {% if intro %}
        <div class="basic-page__intro">{{ intro }}</div>
      {% endif %}
    </header>
    <div{{ content_attributes.addClass('basic-page__card') }}>
      {% if sections %}
        {% for section in sections %}
          <section class="basic-page__section">
            {% if section.icon %}
              <span class="basic-page__icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {% if section.icon == 'user' %}
                    <circle cx="12" cy="8" r="4"/><path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/>
                  {% elseif section.icon == 'mail' %}
                    <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M4 7.5l8 5.5 8-5.5"/>
                  {% elseif section.icon == 'building' %}
                    <path d="M4 20.5h16"/><path d="M6 20.5V8l6-4 6 4v12.5"/><path d="M10 20.5v-4h4v4"/><path d="M9.5 10h.01M14.5 10h.01M9.5 13h.01M14.5 13h.01"/>
                  {% elseif section.icon == 'percent' %}
                    <path d="M18 6L6 18"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>
                  {% elseif section.icon == 'shield' %}
                    <path d="M12 3l7.5 3v5.5c0 4.5-3.1 8.2-7.5 9.5-4.4-1.3-7.5-5-7.5-9.5V6z"/><path d="M12 3v18"/>
                  {% else %}
                    <rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>
                  {% endif %}
                </svg>
              </span>
            {% endif %}
            <div class="basic-page__section-main">
              <h2 class="basic-page__section-title">{{ section.title }}</h2>
              {% if section.text %}
                <div class="basic-page__section-text">{{ section.text }}</div>
              {% endif %}
            </div>
          </section>
        {% endfor %}
        {{ content|without('body') }}
      {% else %}
        <div class="basic-page__body">{{ content }}</div>
      {% endif %}
    </div>
  </article>
{% else %}
  <article{{ attributes }}>
    {{ title_prefix }}
    <h2{{ title_attributes }}><a href="{{ url }}" rel="bookmark">{{ label }}</a></h2>
    {{ title_suffix }}
    <div{{ content_attributes }}>
      {{ content }}
    </div>
  </article>
{% endif %}
