{#
/**
 * @file
 * Theme override for the "offer_to_search_request" webform entity
 * (theme hook: webform; suggestion: webform--offer-to-search-request,
 * from the webform's machine name).
 *
 * IMPORTANT: {{ children }} below is the untouched, unmodified render
 * of the actual <form> — every field, its #type, its validation
 * (native HTML5 + Drupal server-side) and Drupal/Webform's own AJAX
 * file-upload behaviors all come from that single render exactly as
 * Webform + the site's YAML configuration produce it. Nothing here
 * duplicates, clones, or rebuilds a single form field. This template
 * only adds the *wrapper* chrome around that one, single copy of the
 * form:
 *
 *  - Desktop (>780px): the wrapper is inert — the existing sidebar
 *    card (.request-sidebar__card, styled in search-request-detail.css
 *    / components.css) already renders it as the plain white card
 *    from the reference design.
 *
 *  - Mobile (<=780px): CSS hides the form's normal flow position and
 *    turns the SAME panel into a fixed bottom sheet; a compact
 *    "Angebot senden" button is shown in its place and reveals the
 *    sheet on tap (see js/offer-webform.js). The form's DOM node is
 *    never moved or cloned — only CSS position/transform/visibility
 *    changes — so field IDs, name attributes, aria-describedby wiring
 *    and Drupal's AJAX behaviors are completely unaffected.
 *
 * The small "Ihre Daten werden vertraulich behandelt…" trust note
 * (design item 9) is static UI chrome, not a form field, so it's
 * added here rather than in the webform's YAML. It reuses the
 * `.webform-privacy-note` class already defined in components.css.
 */
#}
{{ attach_library('suchauftrag_theme/offer-webform') }}

<div class="offer-webform" data-offer-webform>

  {# Mobile-only compact CTA. Hidden entirely on desktop (CSS) — see
     .offer-webform__mobile-cta. Opens the bottom sheet on tap. #}
  <button type="button" class="offer-webform__mobile-cta" data-offer-webform-open aria-haspopup="dialog" aria-controls="offer-webform-panel">
    Angebot senden
  </button>

  {# Mobile-only backdrop. Inert/hidden on desktop. #}
  <div class="offer-webform__backdrop" data-offer-webform-backdrop hidden></div>

  {# The one and only copy of the card/panel. Plain static card on
     desktop; fixed bottom sheet on mobile (starts translated off
     screen, see CSS). #}
  <div
    class="offer-webform__panel"
    id="offer-webform-panel"
    data-offer-webform-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="offer-webform-heading"
    tabindex="-1"
  >

    {# Drag handle — mobile only, decorative + drag-to-dismiss hook. #}
    <div class="offer-webform__handle" data-offer-webform-handle aria-hidden="true"></div>

    {# Sheet header (title + close) — mobile only. #}
    <div class="offer-webform__panel-header">
      <h2 id="offer-webform-heading" class="offer-webform__heading">Angebot senden</h2>
      <button type="button" class="offer-webform__close" data-offer-webform-close aria-label="Schließen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {# Internal scroll area. On mobile this is the only part that
       scrolls (max-height:90vh on the panel); on desktop it's a
       plain, non-scrolling wrapper around the exact same content. #}
    <div class="offer-webform__scroll" data-offer-webform-scroll>

      {#
        Desktop card heading + description (design item: "Angebot
        senden" / "Machen Sie dem Suchenden ein passendes Angebot.
        Ihre Kontaktdaten werden erst nach Annahme sichtbar."). Reuses
        the .request-sidebar__title / .request-sidebar__text classes
        already defined for exactly this purpose in
        search-request-detail.css (spacing already tuned to the
        reference design there — nothing new added), which were never
        actually output by this template until now.

        On mobile these are hidden via offer-webform.css — the sheet
        already renders its own "Angebot senden" title in
        .offer-webform__panel-header, so this is desktop-only chrome
        and never a duplicate heading in the bottom sheet.
      #}
      <div class="offer-webform__intro">
        <h2 class="request-sidebar__title">Angebot senden</h2>
        <p class="request-sidebar__text">Machen Sie dem Suchenden ein passendes Angebot. Ihre Kontaktdaten werden erst nach Annahme sichtbar.</p>
      </div>

      {{ children }}

      {# Hidden source markup for js/offer-webform.js's submit-button
         icon enhancement (design item 2). Per spec, the icon is
         authored here as real inline SVG (not a CSS background-image
         or encoded content: url() trick) — the JS behavior clones it
         into a decorative overlay it builds over Webform's actual
         submit control. That control renders as a plain
         <input type="submit"> (see suchauftrag_theme_form_alter():
         '#type' is forced to 'button' with '#attributes.type'
         overridden to 'submit', but Drupal's 'button' element still
         renders via input.html.twig either way) — a native <input>
         cannot contain child markup at all, so the icon can only ever
         be layered on top of it, never actually inside its DOM node;
         this <template> is the twig-authored source for that overlay,
         not a live rendered icon on its own (a <template>'s contents
         are inert and unrendered until JS clones them). If JS never
         runs, the real input still fully works via its own
         '#value'/"Angebot senden" text — this enhancement is
         additive, not a replacement of any Webform/Drupal behavior. #}
      <template data-offer-webform-submit-icon>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 3L3 10.5l7.5 3L13.5 21 21 3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M10.5 13.5L21 3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
        </svg>
      </template>

      <p class="webform-privacy-note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4.5" y="10.5" width="15" height="10" rx="1.8" stroke="currentColor" stroke-width="1.6"/>
          <path d="M8 10.5V7.5a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>Ihre Daten werden vertraulich behandelt und nur bei Interesse weitergegeben.</span>
      </p>
    </div>
  </div>
</div>
