{#
/**
 * @file
 * Front page template — Search Requests Overview.
 *
 * Composes the page entirely from reusable includes. No markup for
 * individual sections lives in this file.
 */
#}
{{ attach_library('suchauftrag_theme/search-ajax') }}
{{ attach_library('suchauftrag_theme/saved-searches') }}
{% include '@suchauftrag_theme/templates/includes/header.html.twig' %}

<main id="main-content" class="main-content" role="main">

  {# Hero + Search Card + Feature Icons share ONE continuous background
     band in the reference design — wrap them in a single container so
     the gradient doesn't seam between sections. #}
  <div class="hero-band">
    <div class="hero-band__bg" aria-hidden="true">
      <svg class="hero-band__wave" viewBox="0 0 1440 500" preserveAspectRatio="none" fill="none">
        <path d="M0 260 C 300 160, 500 340, 820 240 S 1300 120, 1440 220 V500H0Z" fill="url(#waveGrad2)" opacity="0.5"/>
        <defs>
          <linearGradient id="waveGrad2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#E9EBFF"/>
            <stop offset="1" stop-color="#F6F8FF"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    {% include '@suchauftrag_theme/templates/includes/hero.html.twig' %}
    {% include '@suchauftrag_theme/templates/includes/search-filter.html.twig' %}
    {% include '@suchauftrag_theme/templates/includes/feature-icons.html.twig' %}
  </div>

  <section class="search-requests" aria-labelledby="search-requests-title">
    <div class="container">
      <div class="search-requests__head">
        <div>
          <h2 id="search-requests-title" class="search-requests__title">Aktuelle Suchaufträge</h2>
          <p class="search-requests__count" id="search-requests-count">{{ search_requests_count is defined ? search_requests_count : 0 }} Suchaufträge gefunden</p>
        </div>
        <div class="search-requests__sort">
          <label for="sort-select" class="sort__label">Sortieren nach</label>
          {% include '@suchauftrag_theme/templates/components/filter-select.html.twig' with {
            id: 'sort-select',
            name: 'sort',
            selected: search_query.sort,
            options: [
              {value: 'newest', label: 'Neueste zuerst'},
              {value: 'oldest', label: 'Älteste zuerst'}
            ]
          } %}
          {#
            "Nur gemerkte anzeigen" — browser-only saved search filter
            (see js/saved-searches.js). Bookmarked node IDs live in
            this visitor's own localStorage; nothing here is a Drupal
            field, View filter, or database table. Hidden on mobile
            per the client spec — see css/responsive.css.
          #}
          <button type="button" class="saved-filter-btn" data-saved-filter-toggle aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 4h11a1 1 0 011 1v16l-6.5-4.3L5.5 21V5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Nur gemerkte anzeigen
          </button>
        </div>
      </div>

      {# Drupal View placeholder — do not hardcode cards here. Built in
         suchauftrag_theme_preprocess_page__front() via $view->preview()
         (views.view.search_requests.yml has use_ajax: true, so this
         also carries the drupalSettings.views.ajaxViews entry
         search-ajax.js needs to talk to Drupal's own /views/ajax).

         #search-results-region is the one stable element search-ajax.js
         replaces on every search — on both branches below, never just
         the inner {{ search_requests_view }} — because which branch
         renders can change between requests (e.g. going from "view
         loaded" to "access denied"), and the wrapper must stay put
         either way for JS to keep finding it. #}
      <div id="search-results-region" aria-live="polite">
        {% if search_requests_view %}
          {{ search_requests_view }}
        {% else %}
          <div class="property-grid__empty-state">
            <p>Aktuell wurden keine Suchaufträge gefunden.</p>
            <p class="u-text-muted">Bitte passen Sie Ihre Filter an oder versuchen Sie es später erneut.</p>
          </div>
        {% endif %}
      </div>

      <div class="search-requests__load-more">
        <button type="button" class="btn btn--outline" data-load-more>
          Weitere Suchaufträge laden
          <svg class="btn__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  {% include '@suchauftrag_theme/templates/includes/cta-banner.html.twig' %}

  <button class="back-to-top" data-back-to-top hidden>
    <span class="back-to-top__icon">↑</span>
    <span class="back-to-top__label">Nach oben</span>
  </button>

</main>

{% include '@suchauftrag_theme/templates/includes/footer.html.twig' %}
