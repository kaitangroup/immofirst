{#
/**
 * @file
 * Theme override for the unformatted row style of the search_requests view.
 *
 * IMPORTANT: This file does NOT hardcode card markup. Each row is mapped
 * to the reusable `property_card` theme hook (see suchauftrag_theme_theme()
 * in suchauftrag_theme.theme). The render arrays themselves are built in
 * suchauftrag_theme_preprocess_views_view_unformatted__search_requests()
 * and exposed here as {{ property_cards }} -- this avoids calling a
 * "theme()" Twig function, which does not exist in core Twig (only the
 * contrib Twig Tweak module adds functions like that).
 *
 * Field machine names read in the preprocess function, now migrated
 * from "suchauftrag" to the "search_request" content type (see that
 * function's own docblock for the full old -> new mapping):
 *   field_request_type      (list: kaufen|mieten)
 *   created                 (base field — search_request has no
 *                            dedicated request-date field)
 *   field_property_type     (list: apartment|house|land|garage|commercial —
 *                            translated to the card's icon keyword)
 *   title                   (base field)
 *   field_location
 *   field_area_min
 *   field_rooms_min
 *   field_price_max
 *   field_notes
 *   (details/offer links are built from the entity URL)
 */
#}
<div{{ attributes.addClass('property-grid__rows') }}>
  {% for key, card in property_cards %}
    <div class="property-grid__item">
      {{ card }}
    </div>
  {% endfor %}
</div>
