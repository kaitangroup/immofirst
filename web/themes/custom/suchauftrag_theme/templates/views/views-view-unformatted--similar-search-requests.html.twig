{#
/**
 * @file
 * Theme override for the unformatted row style of similar_search_requests.
 *
 * Maps each row to the reusable property_cards array generated in
 * preprocess. Markup is a semantic list: on desktop/tablet CSS turns
 * it into a 3- / 2-column grid; on mobile the exact same markup
 * becomes a horizontal, scroll-snapped carousel — purely via CSS
 * (see .similar-cards in css/components.css + css/responsive.css).
 * No JS slider library is used.
 */
#}
<ul class="similar-cards">
  {% for key, card in property_cards %}
    <li class="similar-cards__item">
      {{ card }}
    </li>
  {% endfor %}
</ul>
