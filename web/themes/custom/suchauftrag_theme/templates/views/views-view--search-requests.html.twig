{#
/**
 * @file
 * Theme override for the search_requests view.
 *
 * Wraps the unformatted row output in the grid container. Card markup
 * itself is NOT here — see views-view-unformatted--search-requests.html.twig
 * and templates/components/property-card.html.twig.
 */
#}
<div{{ attributes.addClass('property-grid') }}>
  {% if header %}
    <div class="property-grid__header">{{ header }}</div>
  {% endif %}

  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="property-grid__empty">{{ empty }}</div>
  {% endif %}

  {% if pager %}
    <div class="property-grid__pager">{{ pager }}</div>
  {% endif %}

  {% if footer %}
    <div class="property-grid__footer">{{ footer }}</div>
  {% endif %}
</div>
