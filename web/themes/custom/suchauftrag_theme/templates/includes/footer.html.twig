{#
/**
 * @file
 * Site footer — dark navy gradient, 4 columns, social icons, copyright bar.
 */
#}
<footer class="footer">
  <div class="container footer__grid">

    <div class="footer__col footer__col--brand">
      <a href="/" class="footer__logo">
        <span class="footer__logo-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M3 11.5L12 4l9 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        Suchauftrag.de
      </a>
      <p class="footer__desc">Die Plattform für Immobilien-Suchaufträge. Wir bringen Suchende und Anbieter schnell und einfach zusammen.</p>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Navigation</h3>
      <ul class="footer__links">
        <li><a href="/suchauftraege">Suchaufträge</a></li>
        <li><a href="/suchauftrag/erstellen">Suchauftrag erstellen</a></li>
        <li><a href="/so-funktionierts">So funktioniert's</a></li>
        <li><a href="/ueber-uns">Über uns</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Rechtliches</h3>
      <ul class="footer__links">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
        <li><a href="/agb">AGB</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Kontakt</h3>
      <ul class="footer__contact">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 7l7.5 5.5L19.5 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a href="mailto:info@suchauftrag.de">info@suchauftrag.de</a>
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 4.5h3.5l1.7 4.2-2.3 1.6a11.3 11.3 0 005.8 5.8l1.6-2.3 4.2 1.7v3.5a1.8 1.8 0 01-2 1.8C9.5 20.2 3.8 14.5 3 5.7A1.8 1.8 0 014.8 3.5h.2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a href="tel:+491234567890">+49 123 4567890</a>
        </li>
      </ul>

      <div class="footer__social">
        <a href="#" aria-label="Facebook" class="footer__social-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14.5 21v-7.5h2.5l.4-3H14.5v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H9.5v3h2.2V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="footer__social-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="3.5" width="17" height="17" rx="2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10.5v6M8 7.5v.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 16.5v-3.7c0-1.1.9-2 2-2s2 .9 2 2v3.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>&copy; {{ "now"|date("Y") }} Suchauftrag.de – Alle Rechte vorbehalten.</p>
    </div>
