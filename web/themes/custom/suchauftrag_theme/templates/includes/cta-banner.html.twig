{#
/**
 * @file
 * Bottom CTA banner — gradient background, city illustration, white button.
 */
#}
<section class="cta-banner">
  <div class="container cta-banner__inner">
    <div class="cta-banner__illustration" aria-hidden="true"></div>

    <div class="cta-banner__left">
      <span class="cta-banner__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
          <rect x="5" y="3" width="11" height="18" rx="1.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 7h5M8 10h5M8 13h3" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="17.5" cy="17.5" r="3.2" fill="#fff"/>
          <path d="M16.3 17.5l.9.9 1.6-1.7" stroke="#5664FF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div>
        <h2 class="cta-banner__title">Sie haben eine Immobilie zu verkaufen oder zu vermieten?</h2>
        <p class="cta-banner__text">Erstellen Sie kostenlos einen Suchauftrag und finden Sie passende Interessenten.</p>
      </div>
    </div>

    <a href="/suchauftrag/erstellen" class="btn btn--white cta-banner__button">
      Jetzt Suchauftrag erstellen
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>
