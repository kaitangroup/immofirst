{#
/**
 * @file
 * 4-column feature icon row. Content comes from
 * suchauftrag_theme_preprocess_page__front() ($feature_icons).
 */
#}
<section class="feature-icons" aria-label="Vorteile">
  <div class="container feature-icons__grid">
    {% for item in feature_icons %}
      <div class="feature-icon" data-hover-scale>
        <span class="feature-icon__circle feature-icon__circle--{{ item.color }}" aria-hidden="true">
          {% if item.icon == 'shield' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3.2l6.5 2.6v5.7c0 4.3-2.8 7.2-6.5 8.5-3.7-1.3-6.5-4.2-6.5-8.5V5.8L12 3.2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {% elseif item.icon == 'target' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg>
          {% elseif item.icon == 'lock' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4.8" y="10.5" width="14.4" height="9.5" rx="2.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.8 10.5V7.8a4.2 4.2 0 018.4 0v2.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="15" r="1.3" fill="currentColor" stroke="none"/></svg>
          {% elseif item.icon == 'clock' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 7.5V12l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {% endif %}
        </span>
        <h3 class="feature-icon__title">{{ item.title }}</h3>
        <p class="feature-icon__text">{{ item.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>
