{#
/**
 * @file
 * Reusable search-request / property card.
 *
 * Variables (see suchauftrag_theme_theme() in the .theme file):
 *   request_type   'kaufen' | 'mieten'
 *   badge_label     e.g. 'KAUFEN' / 'MIETEN'
 *   date            e.g. 'Heute', '11.05.2024'
 *   icon            'home' | 'apartment' | 'plot' | 'garage'
 *   title           string
 *   location        string
 *   radius          string, e.g. '10' (km) — appended to location as
 *                   "<location>, <radius> km Umkreis" when non-empty
 *   stats           array of exactly 3 items, in display order, each
 *                   {icon, value, label, empty}. 'empty' TRUE means
 *                   this property type has no metric for this column
 *                   (per the client's Excel mapping table) — rendered
 *                   as an invisible spacer, not omitted, so columns
 *                   1/3 line up the same way across every card
 *                   regardless of property type. See
 *                   _suchauftrag_theme_property_card_stats() in the
 *                   .theme file.
 *   description     string
 *   details_url     string
 *   offer_url       string
 *
 * MARKUP STRUCTURE — three top-level children of .property-card:
 *   .property-card__leading   the property-type icon, alone.
 *   .property-card__content   everything else: badge/date, title,
 *                              location, stats, description, and the
 *                              details link + actions row.
 *   .property-card__trailing  bookmark + a "view details" arrow.
 *
 * On desktop (default CSS), .property-card__leading and
 * .property-card__trailing are hidden (display:none) — the icon and
 * bookmark+actions render in their ORIGINAL positions instead, inside
 * .property-card__content, exactly as before this markup was split
 * into three slots. This intentionally duplicates the icon SVG and
 * the bookmark button in the DOM (each rendered from a single Twig
 * {% set %} block below, not hand-duplicated) — only one copy of each
 * is ever visible at a given viewport width. Duplicating the bookmark
 * button is safe: js/theme.js binds a click handler independently to
 * every [data-bookmark] element, so each copy toggles its own
 * is-active state; since only one copy is visible at a time, the
 * (expected, harmless) lack of state-sync between the two copies is
 * never observable to the visitor.
 *
 * .property-card__details (the "Details ansehen" text link) is
 * intentionally NOT duplicated — js/search-ajax.js reads this exact
 * class's href to de-duplicate "load more" results and to manage
 * focus after an AJAX append (see existingDetailHrefs() there), so it
 * stays a single element. It's simply hidden (not removed) on the
 * mobile compact layout; .property-card__trailing's arrow (a
 * DIFFERENT class, property-card__arrow, same href) is what's visible
 * there instead — see css/responsive.css.
 *
 * At the ≤640px "Mobile" breakpoint, .property-card switches to a
 * horizontal flex row (icon left / content center / bookmark+arrow
 * right), and .property-card__content hides its own inner icon,
 * description, and details/actions row (all superseded by leading/
 * trailing) — see css/responsive.css for the full breakpoint.
 */
#}
{% set icon_markup %}
  <span class="property-card__icon" aria-hidden="true">
    {% if icon == 'apartment' %}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4.5" y="3" width="15" height="18" rx="1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.2 7.2h1.8M14 7.2h1.8M8.2 11h1.8M14 11h1.8M8.2 14.8h1.8M14 14.8h1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif icon == 'plot' %}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 20.5V9.2L12 4l8 5.2v11.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20.5h16M9 20.5v-5.7h6v5.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif icon == 'garage' %}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 10.3L12 4l9 6.3V20H3v-9.7z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 20v-6.3h11V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 16.3h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% else %}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 10.5L12 3.5l9 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 9.5V19a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% endif %}
  </span>
{% endset %}

{% set bookmark_markup %}
  <button type="button" class="property-card__bookmark" data-bookmark aria-pressed="false" aria-label="Zu Favoriten hinzufügen">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6.5 4h11a1 1 0 011 1v16l-6.5-4.3L5.5 21V5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
{% endset %}

<article class="property-card" data-hover-lift>

  {# Mobile-only leading icon — hidden on desktop, see css/responsive.css #}
  <div class="property-card__leading">
    {{ icon_markup }}
  </div>

  <div class="property-card__content">
    <div class="property-card__top">
      {% include '@suchauftrag_theme/templates/components/badge.html.twig' with {
        label: badge_label,
        variant: request_type == 'kaufen' ? 'buy' : 'rent'
      } %}
      <span class="property-card__date">
        {% if date == 'Heute' %}<span class="property-card__date-dot" aria-hidden="true"></span>{% endif %}
        {{ date }}
      </span>
    </div>

    <div class="property-card__middle">
      {{ icon_markup }}
      <h3 class="property-card__title">{{ title }}</h3>
      <p class="property-card__location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21.5s7.2-6.7 7.2-12A7.2 7.2 0 104.8 9.5c0 5.3 7.2 12 7.2 12z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ location }}{% if radius %}, {{ radius }} km Umkreis{% endif %}
      </p>
    </div>

    <div class="property-card__stats">
      {% for stat in stats %}
        {% if stat.empty %}
          <div class="stat-item stat-item--empty" aria-hidden="true"></div>
        {% else %}
          {% include '@suchauftrag_theme/templates/components/stat-item.html.twig' with {
            icon: stat.icon, value: stat.value, label: stat.label
          } %}
        {% endif %}
      {% endfor %}
    </div>

    {% if description %}
      <p class="property-card__description">{{ description }}</p>
    {% endif %}

    <div class="property-card__bottom">
      <a href="{{ details_url }}" class="property-card__details">Details ansehen</a>

      <div class="property-card__actions">
        {% include '@suchauftrag_theme/templates/components/button.html.twig' with {
          text: 'Angebot senden',
          url: offer_url,
          variant: 'primary'
        } %}
        {{ bookmark_markup }}
      </div>
    </div>
  </div>

  {# Mobile-only trailing bookmark + "view details" arrow — hidden on
     desktop, see css/responsive.css. Arrow uses .property-card__arrow
     (NOT .property-card__details) on purpose — see this file's header
     comment. #}
  <div class="property-card__trailing">
    {{ bookmark_markup }}
    <a href="{{ details_url }}" class="property-card__arrow" aria-label="Details ansehen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>
