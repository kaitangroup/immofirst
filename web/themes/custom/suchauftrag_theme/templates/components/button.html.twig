{#
/**
 * @file
 * Reusable button. Variables: text, url, variant (primary|outline|white|ghost), icon.
 */
#}
{% set classes = 'btn btn--' ~ variant %}
{% if url and url != '#' %}
  <a href="{{ url }}" class="{{ classes }}">
    {% if icon == 'search' %}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    {% endif %}
    {{ text }}
  </a>
{% else %}
  <button type="submit" class="{{ classes }}">
    {% if icon == 'search' %}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    {% endif %}
    {{ text }}
  </button>
{% endif %}
