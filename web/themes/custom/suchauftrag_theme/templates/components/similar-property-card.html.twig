{#
/**
 * @file
 * Compact property card for the "Ähnliche Suchaufträge" (Similar Search
 * Requests) section, per the client-approved reference design.
 *
 * Card order (fixed by design spec):
 *   1. Kaufen / Mieten badge
 *   2. Title (2-line clamp)
 *   3. Location + radius
 *   4. Divider
 *   5. Requirement row (Area/Grundstück + Price)
 *   6. Created time
 *   7. Bottom action row (Details ansehen + bookmark)
 *
 * Variables (unchanged — provided by
 * suchauftrag_theme_preprocess_views_view_unformatted(), #theme =>
 * similar_property_card): node_id, request_type, badge_label, date,
 * title, location, radius, stats, details_url.
 *
 * `stats` always contains exactly 3 entries (see
 * _suchauftrag_theme_property_card_stats() in suchauftrag_theme.theme),
 * one of which may be an empty placeholder and one of which may be a
 * non-area/price stat (e.g. Baujahr, Art) depending on property type.
 * The design's "requirement row" only ever shows Area/Grundstück +
 * Price, so we filter down to just those here — this is a display
 * decision made in this template only, the preprocess/data layer is
 * untouched.
 #}
{% set requirement_stats = [] %}
{% for stat in stats %}
  {% if not stat.empty and stat.icon in ['area', 'land', 'price'] %}
    {% set requirement_stats = requirement_stats|merge([stat]) %}
  {% endif %}
{% endfor %}

<article class="similar-card" data-node-id="{{ node_id }}">

  {# 1. Kaufen / Mieten badge #}
  {% include '@suchauftrag_theme/templates/components/badge.html.twig' with {
    label: badge_label,
    variant: request_type == 'kaufen' ? 'buy' : 'rent'
  } %}

  {# 2. Title (2-line clamp handled in CSS: .similar-card__title) #}
  <h3 class="similar-card__title">{{ title }}</h3>

  {# 3. Location + radius #}
  {% if location %}
    <p class="similar-card__location">
      <svg class="similar-card__location-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21.5s7.2-6.7 7.2-12A7.2 7.2 0 104.8 9.5c0 5.3 7.2 12 7.2 12z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{ location }}{% if radius %}, {{ radius }} km Umkreis{% endif %}</span>
    </p>
  {% endif %}

  {# 4. Divider #}
  <hr class="similar-card__divider" aria-hidden="true">

  {# 5. Requirement row (Area/Grundstück + Price) #}
  {% if requirement_stats %}
    <div class="similar-card__meta">
      {% for stat in requirement_stats %}
        {% set unit_suffix = stat.icon == 'price' ? '€' : (stat.icon in ['area', 'land'] ? 'm²' : '') %}
        {% set meta_value = stat.value %}
        {% if unit_suffix and unit_suffix not in meta_value %}
          {% set meta_value = meta_value ~ ' ' ~ unit_suffix %}
        {% endif %}
        <span class="similar-card__meta-item">
          <span class="similar-card__meta-icon" aria-hidden="true">
            {% if stat.icon == 'price' %}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.6 15c.4.7 1.3 1.2 2.4 1.2 1.5 0 2.6-.8 2.6-2 0-1.1-1-1.6-2.6-1.9-1.5-.3-2.4-.8-2.4-1.9 0-1.1 1.1-1.9 2.4-1.9 1.1 0 1.9.5 2.3 1.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 7v1.4M12 15.6V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% elseif stat.icon == 'land' %}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 19.5L12 4l8 15.5H4z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 19.5h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% else %}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 4H4v5M15 4h5v5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          </span>
          <span class="similar-card__meta-value">{{ meta_value }}</span>
        </span>
      {% endfor %}
    </div>
  {% endif %}

  {# 6. Created time #}
  {% if date %}
    <p class="similar-card__date">{{ date }}</p>
  {% endif %}

  {# 7. Bottom action row #}
  <div class="similar-card__actions">
    <a href="{{ details_url }}" class="similar-card__details-btn">Details ansehen</a>
    <button type="button" class="similar-card__bookmark" data-bookmark aria-pressed="false" aria-label="„{{ title }}“ zu Favoriten hinzufügen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6.5 4h11a1 1 0 011 1v16l-6.5-4.3L5.5 21V5a1 1 0 011-1z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</article>
