{#
/**
 * @file
 * Single stat used in the property-card stats row.
 * Variables: icon (area|rooms|price), value, label.
 */
#}
<div class="stat-item">
  <span class="stat-item__icon" aria-hidden="true">
    {% if icon == 'area' %}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 4H4v5M15 4h5v5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif icon == 'rooms' %}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 18v-6.5A2.5 2.5 0 015.5 9H11v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 18v-3.5h18V18M21 14.5V11a2 2 0 00-2-2h-6a2 2 0 00-2 2v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18v2M20 18v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif icon == 'price' %}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.6 15c.4.7 1.3 1.2 2.4 1.2 1.5 0 2.6-.8 2.6-2 0-1.1-1-1.6-2.6-1.9-1.5-.3-2.4-.8-2.4-1.9 0-1.1 1.1-1.9 2.4-1.9 1.1 0 1.9.5 2.3 1.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 7v1.4M12 15.6V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% endif %}
  </span>
  <span class="stat-item__value">{{ value }}</span>
  <span class="stat-item__label">{{ label }}</span>
</div>
