<?php

/**
 * @file
 * Functions to support theming in the Immobilien Theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function immobilien_theme_preprocess_html(array &$variables): void {
  // Mark the front page for CSS scoping.
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['attributes']['class'][] = 'is-front';
  }
  $variables['#attached']['library'][] = 'immobilien_theme/global';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function immobilien_theme_preprocess_page(array &$variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'immobilien_theme/homepage';
    $variables['is_front_page'] = TRUE;
  }
  else {
    $variables['is_front_page'] = FALSE;
  }

  // Expose a theme path variable for asset URLs in templates.
  $variables['immobilien_theme_path'] = \Drupal::service('extension.list.theme')
    ->getPath('immobilien_theme');
}

/**
 * Implements hook_form_alter().
 *
 * Adds theme classes to the property-search form when present.
 */
function immobilien_theme_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  if ($form_id === 'immobilien_search_form') {
    $form['#attributes']['class'][] = 'immobilien-search-form';
  }
}

/**
 * Implements hook_theme().
 *
 * Registers custom template used by the homepage hero + search block.
 */
function immobilien_theme_theme($existing, $type, $theme, $path): array {
  return [
    'immobilien_homepage' => [
      'variables' => [
        'hero_image' => NULL,
        'features' => [],
        'trust_items' => [],
        'steps' => [],
      ],
      'template' => 'immobilien-homepage',
    ],
  ];
}
