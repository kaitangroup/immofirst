{#
/**
 * @file
 * Theme override for the front page.
 *
 * Renders the Immobilien homepage hero, trust bar, feature/search block
 * and 3-step section using data provided by preprocess or default fallbacks.
 */
#}
{% set hero_image_url = hero_image_url ?? (base_path ~ directory ~ '/images/hero-family-house.png') %}

<main role="main" class="homepage" id="main-content">
  <div class="home-shell">

    {# ============= HERO ============= #}
    <section class="hero" aria-labelledby="hero-title">
      <span class="orb orb--a" aria-hidden="true"></span>
      <span class="orb orb--b" aria-hidden="true"></span>

      <div class="hero__grid">
        <div class="hero__content">
          <span class="hero__eyebrow">Exklusiv &amp; kostenlos</span>
          <h1 id="hero-title" class="hero__title">
            {{ 'Finden Sie Ihr neues Zuhause – bevor es andere sehen'|t }}
          </h1>
          <p class="hero__lede">
            {{ 'Erhalten Sie exklusive Immobilienangebote, noch bevor sie öffentlich auf den großen Portalen erscheinen.'|t }}
          </p>

          <ul class="hero__features">
            <li>
              <span class="hero__feature-icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/bell.svg.twig' %}
              </span>
              <span>{{ 'Früher informiert bei neuen Immobilien'|t }}</span>
            </li>
            <li>
              <span class="hero__feature-icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/target.svg.twig' %}
              </span>
              <span>{{ 'Passend zu Ihren Suchkriterien'|t }}</span>
            </li>
            <li>
              <span class="hero__feature-icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/tag.svg.twig' %}
              </span>
              <span>{{ 'Kostenlos &amp; unverbindlich'|t }}</span>
            </li>
          </ul>

          <div class="hero__cta">
            <a href="#suchauftrag" class="btn btn-primary">
              {{ 'Jetzt Suchauftrag starten'|t }}
              <span class="btn-icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/arrow-right.svg.twig' %}
              </span>
            </a>
          </div>
        </div>

        <div class="hero__image-wrap">
          <img class="hero__image"
               src="{{ hero_image_url }}"
               alt="{{ 'Junge Familie steht lächelnd vor einem modernen Haus in der Abendsonne'|t }}"
               loading="eager"
               decoding="async"
               fetchpriority="high" />
          <div class="hero__image-glow" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    {# ============= TRUST BAND ============= #}
    <section class="trust" aria-label="{{ 'Vertrauensmerkmale'|t }}">
      <ul class="trust__list">
        {% set trust_items = [
          'DSGVO-konform'|t,
          'Keine Weitergabe Ihrer Daten'|t,
          'Jederzeit kündbar'|t,
          '100 % kostenlos'|t
        ] %}
        {% for item in trust_items %}
          <li class="trust__item">
            <svg class="trust__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{{ item }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>

    {# ============= WHY + SEARCH FORM ============= #}
    <section class="why" id="suchauftrag" aria-labelledby="why-title">
      <div class="why__grid">
        <div class="why__copy">
          <h2 id="why-title" class="section-title">
            {{ 'Warum sind gute Immobilien immer sofort weg?'|t }}
          </h2>
          <p>{{ 'Viele Immobilien werden bereits vergeben, bevor sie auf bekannten Portalen erscheinen.'|t }}</p>
          <p>{{ 'Mit unserem <strong>Suchauftrag</strong> sind Sie garantiert einen Schritt voraus.'|t }}</p>

          <div class="why__cards">
            <article class="card">
              <span class="card__icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/bell.svg.twig' %}
              </span>
              <h3 class="card__title">{{ 'Früher informiert'|t }}</h3>
              <p class="card__text">
                {{ 'Erhalten Sie Zugriff auf Immobilienangebote, bevor sie auf Portalen wie ImmoScout &amp; Immonet erscheinen.'|t }}
              </p>
            </article>
            <article class="card">
              <span class="card__icon" aria-hidden="true">
                {% include directory ~ '/templates/icons/target.svg.twig' %}
              </span>
              <h3 class="card__title">{{ 'Passende Angebote'|t }}</h3>
              <p class="card__text">
                {{ 'Exklusive Angebote, die genau auf Ihre Wünsche und Ihren Suchauftrag abgestimmt sind.'|t }}
              </p>
            </article>
          </div>
        </div>

        {# --- Search form card --- #}
        <aside class="search-card" aria-labelledby="search-title">
          <h3 id="search-title" class="search-card__title">{{ 'Jetzt Immobilien-Suchauftrag starten'|t }}</h3>

          <form class="immobilien-search-form" method="post" action="#">
            <div class="field">
              <label class="field__label" for="objektart">{{ 'Objektart:'|t }}</label>
              <select class="field__control" id="objektart" name="objektart">
                <option>{{ 'Eigentumswohnung'|t }}</option>
                <option>{{ 'Einfamilienhaus'|t }}</option>
                <option>{{ 'Reihenhaus'|t }}</option>
                <option>{{ 'Mehrfamilienhaus'|t }}</option>
                <option>{{ 'Grundstück'|t }}</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="region">{{ 'Region:'|t }}</label>
              <select class="field__control" id="region" name="region">
                <option>{{ 'Stadt oder PLZ'|t }}</option>
                <option>{{ 'Berlin'|t }}</option>
                <option>{{ 'Hamburg'|t }}</option>
                <option>{{ 'München'|t }}</option>
                <option>{{ 'Köln'|t }}</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="budget-min">{{ 'Budget:'|t }}</label>
              <div class="field--dual">
                <select class="field__control" id="budget-min" name="budget_min" aria-label="{{ 'Kaufpreis von €'|t }}">
                  <option>{{ 'Kaufpreis von €'|t }}</option>
                  <option>100.000 €</option>
                  <option>200.000 €</option>
                  <option>300.000 €</option>
                  <option>500.000 €</option>
                </select>
                <select class="field__control" id="budget-max" name="budget_max" aria-label="{{ 'bis €'|t }}">
                  <option>{{ 'bis €'|t }}</option>
                  <option>300.000 €</option>
                  <option>500.000 €</option>
                  <option>750.000 €</option>
                  <option>1.000.000 €</option>
                </select>
              </div>
            </div>

            <button type="submit" class="btn btn-primary">
              {{ 'Jetzt kostenlos anfragen'|t }}
            </button>
          </form>
        </aside>
      </div>
    </section>

    {# ============= 3 STEPS ============= #}
    <section class="steps-section" aria-labelledby="steps-title">
      <h2 id="steps-title" class="section-title steps-section__title">{{ 'So einfach geht’s:'|t }}</h2>

      <div class="steps">
        <article class="step">
          <span class="step__icon" aria-hidden="true">
            {% include directory ~ '/templates/icons/search.svg.twig' %}
          </span>
          <h3 class="step__title">{{ 'Suchprofil erstellen'|t }}</h3>
          <p class="step__text">{{ 'Beschreiben Sie kurz, was Sie suchen und Ihr Budget.'|t }}</p>
        </article>

        <article class="step">
          <span class="step__icon" aria-hidden="true">
            {% include directory ~ '/templates/icons/bell-alert.svg.twig' %}
          </span>
          <h3 class="step__title">{{ 'Als Erster informiert werden'|t }}</h3>
          <p class="step__text">{{ 'Wir informieren Sie, sobald neue, passende Immobilienangebote verfügbar sind.'|t }}</p>
        </article>

        <article class="step">
          <span class="step__icon" aria-hidden="true">
            {% include directory ~ '/templates/icons/calendar-check.svg.twig' %}
          </span>
          <h3 class="step__title">{{ 'Besichtigung sichern &amp; Traumhaus finden'|t }}</h3>
          <p class="step__text">{{ 'Interessante Immobilien können direkt &amp; exklusiv besichtigt werden.'|t }}</p>
        </article>
      </div>

      <div class="final-cta">
        <a href="#suchauftrag" class="btn btn-primary">
          {{ 'Suchauftrag starten'|t }}
          <span class="btn-icon" aria-hidden="true">
            {% include directory ~ '/templates/icons/chevron-right.svg.twig' %}
          </span>
        </a>
      </div>
    </section>

  </div>
</main>
