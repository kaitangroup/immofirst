<header class="header">
<div class="container">
<div class="header__inner">

{% include '@immofirst_theme/logo/logo.twig' with {url:home_url,image:logo,alt:logo_alt} %}

<nav class="header__nav" aria-label="Primary Navigation">
{% block navigation %}{{ navigation }}{% endblock %}
</nav>

<div class="header__actions">

{% include '@immofirst_theme/language-switcher/language-switcher.twig' %}

{% include '@immofirst_theme/auth-links/auth-links.twig' with {login_url:login_url,register_url:register_url} %}

{% include '@immofirst_theme/button/button.twig' with {url:cta_url,text:cta_text,variant:'primary'} %}

<button class="header__toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
<span></span><span></span><span></span>
</button>

</div>

</div>
</div>
</header>
