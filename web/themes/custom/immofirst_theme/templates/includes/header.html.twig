{#
/**
 * @file
 * Global site header.
 *
 * Available variables:
 * - page.header
 * - page.primary_menu
 * - page.secondary_menu
 */
#}

<header
  id="site-header"
  class="site-header"
  role="banner"
>

  <a
    class="skip-link visually-hidden focusable"
    href="#main-content"
  >
    {{ 'Skip to main content'|t }}
  </a>

  <div class="site-header__container container">

    <div class="site-header__inner">

      {# ------------------------------------------------------------------ #}
      {# Brand #}
      {# ------------------------------------------------------------------ #}

      <div class="site-header__brand">

        <a
          href="{{ path('<front>') }}"
          rel="home"
          class="site-header__logo"
          aria-label="{{ 'Home'|t }}"
        >

          {% if logo %}
            <img
              src="{{ logo }}"
              alt="{{ site_name }}"
              class="site-header__logo-image"
              loading="eager"
              width="180"
              height="48"
            >
          {% else %}
            <span class="site-header__site-name">
              {{ site_name }}
            </span>
          {% endif %}

        </a>

      </div>

      {# ------------------------------------------------------------------ #}
      {# Desktop Navigation #}
      {# ------------------------------------------------------------------ #}

      <nav
        class="site-header__navigation"
        aria-label="{{ 'Primary navigation'|t }}"
      >

        {{ page.primary_menu }}

      </nav>

      {# ------------------------------------------------------------------ #}
      {# Utilities #}
      {# ------------------------------------------------------------------ #}

      <div class="site-header__utilities">

        {# Search Placeholder #}
        <button
          class="site-header__icon-button site-header__search-toggle"
          type="button"
          aria-label="{{ 'Open search'|t }}"
          aria-expanded="false"
        >

          Search

        </button>

        {# Notification Placeholder #}
        <button
          class="site-header__icon-button site-header__notification-toggle"
          type="button"
          aria-label="{{ 'Notifications'|t }}"
        >

          Notifications

        </button>

        {# Language Switcher Region #}
        <div class="site-header__language">

          {{ page.language }}

        </div>

        {# Authentication #}
        <div class="site-header__auth">

          <a
            href="{{ path('user.login') }}"
            class="site-header__login"
          >
            {{ 'Login'|t }}
          </a>

          <a
            href="{{ path('user.register') }}"
            class="site-header__register"
          >
            {{ 'Register'|t }}
          </a>

        </div>

        {# CTA #}
        <a
          href="{{ path('user.register') }}"
          class="button button--primary site-header__cta"
        >
          {{ 'Get Started'|t }}
        </a>

      </div>

      {# ------------------------------------------------------------------ #}
      {# Mobile Toggle #}
      {# ------------------------------------------------------------------ #}

      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="{{ 'Toggle navigation'|t }}"
      >

        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>

      </button>

    </div>

  </div>

  {# ---------------------------------------------------------------------- #}
  {# Mobile Navigation #}
  {# ---------------------------------------------------------------------- #}

  <div
    id="mobile-navigation"
    class="site-header__mobile"
    hidden
  >

    <nav
      class="site-header__mobile-nav"
      aria-label="{{ 'Mobile navigation'|t }}"
    >

      {{ page.primary_menu }}

    </nav>

    <div class="site-header__mobile-language">

      {{ page.language }}

    </div>

    <div class="site-header__mobile-auth">

      <a href="{{ path('user.login') }}">
        {{ 'Login'|t }}
      </a>

      <a href="{{ path('user.register') }}">
        {{ 'Register'|t }}
      </a>

    </div>

    <a
      href="{{ path('user.register') }}"
      class="button button--primary"
    >
      {{ 'Get Started'|t }}
    </a>

  </div>

</header>