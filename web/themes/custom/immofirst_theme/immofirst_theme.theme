<?php


declare(strict_types=1);

/**
 * @file
 * Theme hooks and preprocess functions for ImmoFirst.
 */

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function immofirst_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::service('path.current')->getPath() === '/front') {
    $suggestions[] = 'page__front';
  }
}

/**
 * Implements hook_preprocess_html().
 */
function immofirst_theme_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'theme-immofirst';
}

/**
 * Implements hook_preprocess_page().
 */
function immofirst_theme_preprocess_page(array &$variables): void {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
}